---
interface Props {
  text: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
  download?: boolean;
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
  ariaLabel?: string;
}

const { 
  text, 
  href, 
  variant = 'primary',
  class: className = '',
  download = false,
  target,
  rel = target === '_blank' ? 'noopener noreferrer' : undefined,
  ariaLabel
} = Astro.props;

const Tag = href ? 'a' : 'button';
const attrs = {
  class: `btn btn-${variant} ${className}`,
  ...(href && { href }),
  ...(download && { download }),
  ...(target && { target }),
  ...(rel && { rel }),
  'aria-label': ariaLabel || text
};
---

<Tag {...attrs}>
  <slot name="icon-before" />
  <span>{text}</span>
  <slot name="icon-after" />
</Tag>

<style>
  /* Base styles are in global.css */
  .btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    min-height: 44px; /* Ensure minimum tap target size */
  }
  
  .btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-medium);
  }
  
  .btn:hover::after {
    transform: scaleX(1);
  }
  
  /* Ensure proper spacing when icons are used */
  :global(.btn svg) {
    width: 1.2em;
    height: 1.2em;
  }
</style>