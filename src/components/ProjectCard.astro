---
import Tag from './Tag.astro';

interface Props {
  title: string;
  description: string;
  technologies: string[];
  githubUrl?: string;
  demoUrl?: string;
  demoDisabled?: boolean;
  comingSoon?: boolean;
  class?: string;
}

const {
  title,
  description,
  technologies,
  githubUrl,
  demoUrl,
  demoDisabled = false,
  comingSoon = false,
  class: className = ''
} = Astro.props;
---

<div class={`project-card ${className}`}>
  <div class="project-content">
    <h3>{title}</h3>
    <p class="project-description">{description}</p>
    <div class="project-tech">
      {technologies.map(tech => (
        <Tag text={tech} variant="primary" />
      ))}
    </div>
    <div class="project-links">
      {comingSoon ? (
        <span class="coming-soon">Coming soon</span>
      ) : (
        <>
          {githubUrl && (
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`GitHub repository for ${title}`}>
              GitHub
            </a>
          )}
          {demoUrl && !demoDisabled ? (
            <a href={demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Live demo for ${title}`}>
              Live Demo
            </a>
          ) : (
            <span class="link-disabled" aria-disabled="true">Live Demo</span>
          )}
        </>
      )}
    </div>
  </div>
</div>

<style>
  .project-card {
    --card-rgb: 56, 189, 248;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-medium), background-color var(--transition-medium), transform var(--transition-medium);
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    background-color: var(--color-card-bg-hover);
  }

  .project-content {
    padding: var(--space-lg);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-text);
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .project-description {
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: var(--fs-body);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(var(--color-primary-rgb), 0.1);
  }

  .project-links a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--fs-body);
    position: relative;
    transition: all var(--transition-fast);
    padding: var(--space-xs) 0;
    display: flex;
    align-items: center;
  }

  .project-links a::before {
    content: '→';
    opacity: 0;
    margin-right: -10px;
    transition: all var(--transition-fast);
  }

  .project-links a:hover::before {
    opacity: 1;
    margin-right: 5px;
  }

  .project-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition-medium);
  }

  .project-links a:hover {
    color: var(--color-secondary);
  }

  .project-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
    background-color: var(--color-secondary);
  }

  .link-disabled {
    color: var(--color-text-faint);
    font-weight: 500;
    font-size: var(--fs-body);
    padding: var(--space-xs) 0;
    cursor: not-allowed;
    text-decoration: line-through;
    text-decoration-color: var(--color-border-strong);
    display: inline-flex;
    align-items: center;
  }

  .coming-soon {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text-faint);
    font-style: italic;
    padding: var(--space-xs) 0;
  }

  @media (max-width: 768px) {
    .project-content {
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>
