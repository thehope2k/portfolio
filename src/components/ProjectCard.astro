---
import Tag from './Tag.astro';

interface Props {
  title: string;
  description: string;
  technologies: string[];
  githubUrl?: string;
  demoUrl?: string;
  class?: string;
}

const {
  title,
  description,
  technologies,
  githubUrl,
  demoUrl,
  class: className = ''
} = Astro.props;
---

<div class={`project-card ${className}`}>
  <div class="project-content">
    <h3>{title}</h3>
    <p class="project-description">{description}</p>
    <div class="project-tech">
      {technologies.map(tech => (
        <Tag text={tech} variant="primary" />
      ))}
    </div>
    <div class="project-links">
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`GitHub repository for ${title}`}>
          GitHub
        </a>
      )}
      {demoUrl && (
        <a href={demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Live demo for ${title}`}>
          Live Demo
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .project-card {
    --card-rgb: 0, 191, 255;
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-medium), box-shadow var(--transition-medium), background var(--transition-medium);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(170deg, rgba(var(--card-rgb), 0.45) 0%, rgba(var(--card-rgb), 0.08) 50%, rgba(255, 255, 255, 0.04) 100%) border-box;
    border: 1px solid transparent;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 14px 36px rgba(0, 0, 0, 0.22),
      0 0 20px rgba(var(--card-rgb), 0.08);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(170deg, rgba(var(--card-rgb), 0.65) 0%, rgba(var(--card-rgb), 0.14) 50%, rgba(255, 255, 255, 0.06) 100%) border-box;
  }

  .project-content {
    padding: var(--space-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  h3 {
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
    font-size: calc(var(--fs-h3) * 0.9);
    position: relative;
    display: inline-block;
  }

  h3::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 36px;
    height: 2px;
    background: var(--color-primary);
    opacity: 0.6;
    transition: width var(--transition-medium);
  }

  .project-card:hover h3::after {
    width: 56px;
  }

  .project-description {
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    font-size: var(--fs-body);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .project-links {
    display: flex;
    gap: var(--space-md);
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(var(--color-primary-rgb), 0.1);
  }

  .project-links a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--fs-body);
    position: relative;
    transition: all var(--transition-fast);
    padding: var(--space-xs) 0;
    display: flex;
    align-items: center;
  }

  .project-links a::before {
    content: '→';
    opacity: 0;
    margin-right: -10px;
    transition: all var(--transition-fast);
  }

  .project-links a:hover::before {
    opacity: 1;
    margin-right: 5px;
  }

  .project-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--transition-medium);
  }

  .project-links a:hover {
    color: var(--color-secondary);
  }

  .project-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
    background-color: var(--color-secondary);
  }

  @media (max-width: 768px) {
    .project-content {
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>
