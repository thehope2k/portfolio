---
// ResumeModal.astro - A cute modal for the resume download prank
---

<div id="resumeModal" class="modal-overlay">
  <div class="modal-content">
    <button id="closeModal" class="close-button" aria-label="Close modal">×</button>
    <div class="modal-body">
      <div class="emoji">😉</div>
      <h2>Oops! No resume here!</h2>
      <p>Well, you won’t find my résumé here—some secrets are best shared in private. Hit me up directly. Love you! ❤️</p>
    </div>
  </div>
</div>

<script>
  // Get modal elements
  const modal = document.getElementById('resumeModal');
  const closeButton = document.getElementById('closeModal');

  // Function to open modal
  window.openResumeModal = function() {
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden'; // Prevent scrolling when modal is open
    }
  };

  // Function to close modal
  function closeModal() {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = ''; // Restore scrolling
    }
  }

  // Event listeners
  if (closeButton) {
    closeButton.addEventListener('click', closeModal);
  }

  // Close modal when clicking outside the content
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  }

  // Close modal with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
      closeModal();
    }
  });
</script>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-content {
    background-color: var(--color-card-bg);
    border-radius: 12px;
    padding: 2rem;
    max-width: 90%;
    width: 400px;
    position: relative;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    transform: scale(0.9);
    transition: transform 0.3s ease;
    border: 2px solid var(--color-primary);
  }

  .modal-overlay.active .modal-content {
    transform: scale(1);
  }

  .close-button {
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 1.5rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .close-button:hover {
    color: var(--color-primary);
  }

  .modal-body {
    text-align: center;
  }

  .emoji {
    font-size: 4rem;
    margin-bottom: 1rem;
    animation: bounce 2s infinite;
  }

  h2 {
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  p {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-20px);
    }
    60% {
      transform: translateY(-10px);
    }
  }

  /* Responsive adjustments */
  @media (min-width: 1024px) {
    .modal-content {
      padding: 1.7rem;
      width: 380px;
    }

    .emoji {
      font-size: 3.3rem;
      margin-bottom: 0.7rem;
    }

    h2 {
      margin-bottom: 0.8rem;
      font-size: 1.4rem;
    }

    p {
      font-size: 1rem;
      line-height: 1.45;
    }
  }

  @media (max-width: 480px) {
    .modal-content {
      padding: 1.5rem;
      width: 85%;
    }

    .emoji {
      font-size: 3rem;
    }

    h2 {
      font-size: 1.3rem;
    }

    p {
      font-size: 1rem;
    }
  }
</style>
