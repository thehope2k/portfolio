---
interface Props {
  title: string;
  description: string;
  icon: string;
  previewText: string;
  buttonText: string;
  buttonLink: string;
  variant: 'professional' | 'personal' | 'growth';
  class?: string;
}

const {
  title,
  description,
  icon,
  previewText,
  buttonText,
  buttonLink,
  variant,
  class: className = ''
} = Astro.props;

const rgbMap = {
  professional: '0, 191, 255',
  personal: '0, 255, 204',
  growth: '255, 102, 0'
};

const cardIndex = variant === 'professional' ? 1 : variant === 'personal' ? 2 : 3;
const rgb = rgbMap[variant];
---

<a
  href={buttonLink}
  class={`section-card ${variant} ${className}`}
  style={`--card-rgb: ${rgb}; --card-index: ${cardIndex};`}
>
  <!-- Inner ambient glow -->
  <div class="card-glow" aria-hidden="true"></div>

  <div class="card-header">
    <div class="icon-ring">
      <i data-lucide={icon}></i>
    </div>
    <h3>{title}</h3>
  </div>

  <p>{description}</p>

  <div class="card-footer">
    <span class="preview-content">{previewText}</span>
    <span class="card-cta">
      {buttonText}
      <span class="btn-arrow">→</span>
    </span>
  </div>
</a>

<style>
  .section-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
    padding: var(--space-md);
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: calc(var(--card-index, 0) * 0.12s);
    text-align: left;
    height: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    /* Gradient border */
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(
        150deg,
        rgba(var(--card-rgb), 0.5) 0%,
        rgba(var(--card-rgb), 0.08) 40%,
        rgba(255, 255, 255, 0.03) 100%
      ) border-box;
    border: 1px solid transparent;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .section-card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 20px 48px rgba(0, 0, 0, 0.3),
      0 0 30px rgba(var(--card-rgb), 0.08);
  }

  /* Ambient inner glow */
  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at 15% 0%,
      rgba(var(--card-rgb), 0.1) 0%,
      transparent 55%
    );
    pointer-events: none;
    z-index: 0;
    transition: opacity var(--transition-medium);
  }

  .section-card:hover .card-glow {
    background: radial-gradient(
      ellipse at 15% 0%,
      rgba(var(--card-rgb), 0.16) 0%,
      transparent 55%
    );
  }

  /* Header: icon + title inline */
  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    position: relative;
    z-index: 1;
  }

  .icon-ring {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(var(--card-rgb), 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--card-rgb), 0.08);
    flex-shrink: 0;
    transition: all var(--transition-medium);
  }

  .section-card:hover .icon-ring {
    background: rgba(var(--card-rgb), 0.14);
    border-color: rgba(var(--card-rgb), 0.55);
    box-shadow: 0 0 16px rgba(var(--card-rgb), 0.15);
  }

  .icon-ring i {
    width: 20px;
    height: 20px;
    stroke-width: 1.5;
    color: rgba(var(--card-rgb), 0.9);
    stroke: rgba(var(--card-rgb), 0.9);
  }

  h3 {
    font-size: calc(var(--fs-h3) * 0.85);
    color: rgba(var(--card-rgb), 0.95);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  p {
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: var(--fs-body);
    font-weight: 300;
    letter-spacing: 0.01em;
    position: relative;
    z-index: 1;
    flex: 1;
    margin: 0 0 var(--space-md) 0;
  }

  /* Footer: preview text + CTA */
  .card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(var(--card-rgb), 0.1);
    padding-top: var(--space-sm);
    margin-top: auto;
  }

  .preview-content {
    font-size: var(--fs-small);
    color: rgba(var(--card-rgb), 0.45);
    font-style: italic;
    font-weight: 300;
    line-height: 1.4;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(var(--card-rgb), 0.8);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: all var(--transition-medium);
  }

  .section-card:hover .card-cta {
    color: rgba(var(--card-rgb), 1);
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
    display: inline-block;
  }

  .section-card:hover .btn-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .section-card {
      padding: var(--space-sm) var(--space-md);
    }

    h3 {
      font-size: calc(var(--fs-h3) * 0.8);
    }
  }
</style>
