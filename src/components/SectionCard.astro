---
interface Props {
  title: string;
  description: string;
  icon: string;
  previewText: string;
  buttonText: string;
  buttonLink: string;
  variant: 'professional' | 'personal' | 'growth';
  class?: string;
}

const {
  title,
  description,
  icon,
  previewText,
  buttonText,
  buttonLink,
  variant,
  class: className = ''
} = Astro.props;

const rgbMap = {
  professional: '0, 191, 255',
  personal: '0, 255, 204',
  growth: '255, 102, 0'
};

const cardIndex = variant === 'professional' ? 1 : variant === 'personal' ? 2 : 3;
const rgb = rgbMap[variant];
---

<a
  href={buttonLink}
  class={`section-card ${variant} ${className}`}
  style={`--card-rgb: ${rgb}; --card-index: ${cardIndex};`}
>
  <!-- Inner ambient glow -->
  <div class="card-glow" aria-hidden="true"></div>

  <div class="card-header">
    <div class="icon-ring">
      <i data-lucide={icon}></i>
    </div>
    <h3>{title}</h3>
  </div>

  <p>{description}</p>

  <div class="card-footer">
    <span class="preview-content">{previewText}</span>
    <span class="card-cta">
      {buttonText}
      <span class="btn-arrow">→</span>
    </span>
  </div>
</a>

<style>
  .section-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-medium), background-color var(--transition-medium), transform var(--transition-medium);
    padding: var(--space-md);
    animation: fadeInUp 0.5s ease-out both;
    animation-delay: calc(var(--card-index, 0) * 0.08s);
    text-align: left;
    height: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .section-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    background-color: var(--color-card-bg-hover);
  }

  /* Ambient inner glow */
  .card-glow {
    display: none;
  }

  .section-card:hover .card-glow {
    display: none;
  }

  /* Header: icon + title inline */
  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    position: relative;
    z-index: 1;
  }

  .icon-ring {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    flex-shrink: 0;
    transition: all var(--transition-medium);
  }

  .section-card:hover .icon-ring {
    border-color: rgba(var(--card-rgb), 0.5);
  }

  .icon-ring i {
    width: 18px;
    height: 18px;
    stroke-width: 1.5;
    color: var(--color-primary);
    stroke: var(--color-primary);
  }

  h3 {
    font-size: calc(var(--fs-h3) * 0.82);
    color: var(--color-text);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  p {
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: var(--fs-body);
    font-weight: 300;
    letter-spacing: 0.01em;
    position: relative;
    z-index: 1;
    flex: 1;
    margin: 0 0 var(--space-md) 0;
  }

  /* Footer: preview text + CTA */
  .card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-sm);
    margin-top: auto;
  }

  .preview-content {
    font-size: var(--fs-small);
    color: var(--color-text-faint);
    font-weight: 300;
    line-height: 1.4;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: all var(--transition-medium);
  }

  .section-card:hover .card-cta {
    color: var(--color-primary);
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
    display: inline-block;
  }

  .section-card:hover .btn-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .section-card {
      padding: var(--space-sm) var(--space-md);
    }

    h3 {
      font-size: calc(var(--fs-h3) * 0.8);
    }
  }
</style>
