---
interface Props {
  title: string;
  description: string;
  icon: string;
  previewText: string;
  buttonText: string;
  buttonLink: string;
  variant: 'professional' | 'personal' | 'growth';
  class?: string;
}

const { 
  title, 
  description, 
  icon,
  previewText,
  buttonText,
  buttonLink,
  variant,
  class: className = ''
} = Astro.props;

// Map variants to colors
const colorMap = {
  professional: {
    color: 'rgba(0, 191, 255, 0.85)',
    previewColor: 'rgba(0, 191, 255, 0.6)',
    buttonColor: 'rgba(0, 191, 255, 0.7)',
    buttonHoverColor: 'rgba(0, 191, 255, 0.9)',
    borderColor: 'rgba(0, 191, 255, 0.7)',
    gradientColor: 'rgba(0, 191, 255, 0.4)'
  },
  personal: {
    color: 'rgba(0, 255, 204, 0.85)',
    previewColor: 'rgba(0, 255, 204, 0.6)',
    buttonColor: 'rgba(0, 255, 204, 0.7)',
    buttonHoverColor: 'rgba(0, 255, 204, 0.9)',
    borderColor: 'rgba(0, 255, 204, 0.7)',
    gradientColor: 'rgba(0, 255, 204, 0.4)'
  },
  growth: {
    color: 'rgba(255, 102, 0, 0.85)',
    previewColor: 'rgba(255, 102, 0, 0.6)',
    buttonColor: 'rgba(255, 102, 0, 0.7)',
    buttonHoverColor: 'rgba(255, 102, 0, 0.9)',
    borderColor: 'rgba(255, 102, 0, 0.7)',
    gradientColor: 'rgba(255, 102, 0, 0.4)'
  }
};

const colors = colorMap[variant];
---

<div class={`section-card ${variant} ${className}`} style={`--card-color: ${colors.color}; --card-index: ${variant === 'professional' ? 1 : variant === 'personal' ? 2 : 3};`}>
  <div class="card-icon">
    <i data-lucide={icon}></i>
  </div>
  <div class="card-content">
    <h3>{title}</h3>
    <p>
      {description}
    </p>
    <div class="preview-content">
      {previewText}
    </div>
    <a href={buttonLink} class="card-button">
      {buttonText}
    </a>
  </div>
</div>

<style>
  .section-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    transition: all var(--transition-medium);
    padding: var(--space-md);
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: calc(var(--card-index, 0) * 0.1s);
    text-align: center;
    border-left: 1px solid rgba(255, 255, 255, 0.05);
    height: 100%; /* Ensure equal height */
    min-height: 340px; /* Reduced minimum height */
    transform-origin: center; /* For smooth rotation */
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .section-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100%),
      radial-gradient(circle at 100% 100%, rgba(0, 0, 0, 0.08) 0%, transparent 50%);
    z-index: 1;
    opacity: 0.8;
    transition: opacity 0.4s ease;
  }

  .section-card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 30px;
    height: 30px;
    z-index: 1;
    opacity: 0.2;
    transition: opacity 0.3s ease;
  }

  .professional {
    border-top: 2px solid rgba(0, 191, 255, 0.7);
  }

  .personal {
    border-top: 2px solid rgba(0, 255, 204, 0.7);
  }

  .growth {
    border-top: 2px solid rgba(255, 102, 0, 0.7);
  }

  .professional::after {
    background: radial-gradient(circle at top right, rgba(0, 191, 255, 0.4), transparent 70%);
  }

  .personal::after {
    background: radial-gradient(circle at top right, rgba(0, 255, 204, 0.4), transparent 70%);
  }

  .growth::after {
    background: radial-gradient(circle at top right, rgba(255, 102, 0, 0.4), transparent 70%);
  }

  .section-card:hover {
    transform: translateY(-5px);
    box-shadow: 
      0 10px 20px rgba(0, 0, 0, 0.15),
      0 0 15px rgba(var(--color-primary-rgb), 0.1);
  }

  .section-card:hover::after {
    opacity: 0.4;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 50px; /* Reduced height */
    margin-bottom: var(--space-sm); /* Reduced margin */
    position: relative;
    z-index: 2;
    transition: all var(--transition-medium);
  }

  .card-icon i {
    width: 40px; /* Increased size */
    height: 40px; /* Increased size */
    stroke-width: 1.25; /* Slightly thinner for modern look */
    transition: all var(--transition-medium);
    color: var(--card-color);
    stroke: var(--card-color);
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.1));
  }

  .section-card:hover .card-icon i {
    transform: translateY(-3px);
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.15));
  }

  .card-content {
    flex: 1;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: space-between; /* Distribute space evenly */
  }

  h3 {
    margin-bottom: var(--space-xs); /* Reduced margin */
    font-size: calc(var(--fs-h3) * 0.9);
    color: var(--card-color);
    position: relative;
    font-weight: 500;
    letter-spacing: 0;
  }

  p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs); /* Further reduced margin */
    line-height: 1.6; /* Reduced line height */
    font-size: var(--fs-body);
    max-width: 42em;
    font-weight: 300;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .preview-content {
    font-size: var(--fs-small);
    padding: var(--space-xs) 0; /* Reduced padding */
    margin-bottom: var(--space-xs); /* Further reduced margin */
    border-radius: 4px;
    background-color: transparent;
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: 300;
    width: 100%;
    text-align: center;
  }

  .professional .preview-content {
    color: rgba(0, 191, 255, 0.6);
  }

  .personal .preview-content {
    color: rgba(0, 255, 204, 0.6);
  }

  .growth .preview-content {
    color: rgba(255, 102, 0, 0.6);
  }

  .card-button {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 400;
    padding: 0.6rem 1.5rem;
    transition: all var(--transition-medium);
    margin-top: var(--space-sm); /* Fixed margin instead of auto */
    position: relative;
    overflow: hidden;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  .card-button::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-medium);
  }

  .professional .card-button {
    color: rgba(0, 191, 255, 0.7);
  }

  .personal .card-button {
    color: rgba(0, 255, 204, 0.7);
  }

  .growth .card-button {
    color: rgba(255, 102, 0, 0.7);
  }

  .card-button:hover {
    color: var(--color-text);
  }

  .professional .card-button:hover {
    color: rgba(0, 191, 255, 0.9);
  }

  .personal .card-button:hover {
    color: rgba(0, 255, 204, 0.9);
  }

  .growth .card-button:hover {
    color: rgba(255, 102, 0, 0.9);
  }

  .card-button:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (max-width: 768px) {
    .section-card {
      padding: var(--space-md);
    }

    .card-icon {
      margin-bottom: var(--space-sm);
    }

    h3 {
      font-size: calc(var(--fs-h3) * 0.85);
    }

    p {
      margin-bottom: var(--space-xs); /* Keep consistent with desktop */
    }
  }

  @media (max-width: 480px) {
    .preview-content {
      padding: var(--space-xs);
      margin-bottom: var(--space-xs); /* Keep consistent with desktop */
    }
  }
</style>
