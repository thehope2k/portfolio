---
interface Props {
  title: string;
  url: string;
  platforms?: ('twitter' | 'linkedin' | 'facebook' | 'email')[];
  class?: string;
}

const {
  title,
  url,
  platforms = ['twitter', 'linkedin'],
  class: className = ''
} = Astro.props;

const absoluteUrl = url.startsWith('http') ? url : Astro.url.origin + url;

const shareUrls = {
  twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(absoluteUrl)}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(absoluteUrl)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(absoluteUrl)}`,
  email: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`Check out this article: ${absoluteUrl}`)}`
};

const platformNames = {
  twitter: 'Twitter',
  linkedin: 'LinkedIn',
  facebook: 'Facebook',
  email: 'Email'
};
---

<div class={`share-section ${className}`}>
  <p class="share-label">Share this post</p>
  <div class="share-links">
    {platforms.map(platform => (
      <a
        href={shareUrls[platform]}
        target="_blank"
        rel="noopener noreferrer"
        class="share-link"
        aria-label={`Share on ${platformNames[platform]}`}
      >
        {platformNames[platform]}
      </a>
    ))}
  </div>
</div>

<style>
  .share-section {
    margin-top: var(--space-lg);
  }

  .share-label {
    font-size: var(--fs-body);
    font-weight: 500;
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
  }

  .share-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .share-link {
    --link-rgb: 0, 191, 255;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 1.1rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    color: rgba(var(--link-rgb), 0.8);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: all var(--transition-medium);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(150deg, rgba(var(--link-rgb), 0.4) 0%, rgba(var(--link-rgb), 0.08) 100%) border-box;
    border: 1px solid transparent;
    min-height: 36px;
  }

  .share-link:hover {
    color: rgba(var(--link-rgb), 1);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(150deg, rgba(var(--link-rgb), 0.7) 0%, rgba(var(--link-rgb), 0.15) 100%) border-box;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(var(--link-rgb), 0.12);
  }
</style>
