<!-- Stage 3 · beat: the loop -->
<section class="slide beat">
  <div class="beat-l">
    <div class="kicker">Stage 3 · Autonomy</div>
    <div class="swap">
      <h2 class="h2" data-step="0" data-out="4">Six steps.<br />How does it <em>keep going</em>?</h2>
      <h2 class="h2" data-step="4">Put the model<br />in a <em>loop</em>.</h2>
    </div>
    <div class="code" data-step="4"><span class="new"><b class="k">while</b> not done:</span><span class="new">  step = llm(goal + history)</span><span class="new">  result = run(step)</span><span class="new">  history += result</span></div>
    <p class="note" data-step="4">Same tools as before. The only new thing is <b>letting it go again</b> — after seeing what happened.</p>
    <div class="tags" data-step="5"><span>Agent loop</span><span>ReAct</span><span>Tool use</span></div>
  </div>
  <div class="beat-r">
    <svg class="d" viewBox="0 0 660 520">
      <rect class="n a" x="0" y="10" width="190" height="64" rx="12" />
      <text x="18" y="38" class="b fa">Goal</text>
      <text x="18" y="58" class="s">swap size 41 → 42</text>
      <path class="e" d="M192 50 Q 250 56 268 112" />

      <g data-step="1">
        <rect class="n k" x="250" y="116" width="170" height="72" rx="14" />
        <text x="335" y="148" text-anchor="middle" class="b w">Think</text>
        <text x="335" y="169" text-anchor="middle" class="s wm">LLM picks the next step</text>
      </g>
      <g data-step="2">
        <path class="e a" d="M422 160 Q 520 180 520 316" />
        <rect class="n" x="440" y="320" width="170" height="72" rx="14" />
        <text x="525" y="352" text-anchor="middle" class="b">Act</text>
        <text x="525" y="373" text-anchor="middle" class="s">call a tool</text>
      </g>
      <g data-step="3">
        <path class="e a" d="M440 370 Q 335 430 232 372" />
        <rect class="n" x="60" y="320" width="170" height="72" rx="14" />
        <text x="145" y="352" text-anchor="middle" class="b">Observe</text>
        <text x="145" y="373" text-anchor="middle" class="s">read the result</text>
      </g>
      <g data-step="4">
        <path class="e a" d="M145 318 Q 150 180 248 160" />
        <text x="335" y="262" text-anchor="middle" class="m fa">↻ repeat until done</text>
        <path class="e g dash" d="M422 130 Q 520 120 540 74" />
        <rect class="n g" x="470" y="10" width="190" height="64" rx="12" />
        <text x="488" y="38" class="b fg">Done</text>
        <text x="488" y="58" class="s">reply to the customer</text>
      </g>
      <g data-step="5">
        <text x="330" y="470" text-anchor="middle" class="b lg">Agent = LLM + tools + a loop</text>
      </g>
