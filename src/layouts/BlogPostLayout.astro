---
import MainLayout from './MainLayout.astro';
import Tag from '../components/Tag.astro';
import ShareLinks from '../components/ShareLinks.astro';

interface Props {
  frontmatter: {
    title: string;
    date: string;
    category: string;
    description: string;
    image?: string;
  };
}

const { frontmatter } = Astro.props;
const formattedDate = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const section = Astro.url.pathname.split('/')[1];
const backUrl = `/${section}`;
const backText = `All ${section.charAt(0).toUpperCase() + section.slice(1)}`;
---

<MainLayout
  title={`${frontmatter.title} | The Hope`}
  description={frontmatter.description}
  image={frontmatter.image}
  type="article"
  publishDate={frontmatter.date}
>
  <article class="blog-post">
    <div class="post-header">
      <a href={backUrl} class="back-link" aria-label={`Return to ${backText}`}>← {backText}</a>
      <h1>{frontmatter.title}</h1>
      <div class="post-meta">
        <time datetime={new Date(frontmatter.date).toISOString()} class="post-date">{formattedDate}</time>
        <Tag text={frontmatter.category} variant="secondary" class="post-category" />
      </div>
    </div>

    <div class="post-content">
      <slot />
    </div>

    <div class="post-footer">
      <div class="post-footer-row">
        <a href={backUrl} class="back-cta">
          <span class="back-arrow">←</span>
          {backText}
        </a>

        <ShareLinks
          title={frontmatter.title}
          url={Astro.url.href}
          platforms={['twitter', 'linkedin', 'facebook', 'email']}
        />
      </div>
    </div>
  </article>
</MainLayout>

<style>
  .blog-post {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-md) 0 var(--space-sm);
  }

  .post-header {
    margin-bottom: var(--space-lg);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-sm);
    color: var(--color-secondary);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: 500;
    transition: color var(--transition-fast);
    padding: var(--space-xs) 0;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  h1 {
    font-size: clamp(1.5rem, 5vw, 2.75rem);
    margin-bottom: var(--space-sm);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-secondary);
    font-size: var(--fs-small);
  }

  .post-date {
    color: var(--color-secondary);
  }

  .post-content {
    line-height: 1.8;
    margin-bottom: var(--space-lg);
  }

  /* Markdown content styling */
  .post-content :global(h2) {
    font-size: var(--fs-h2);
    margin: var(--space-lg) 0 var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .post-content :global(h3) {
    font-size: var(--fs-h3);
    margin: var(--space-md) 0 var(--space-sm);
  }

  .post-content :global(p) {
    margin-bottom: var(--space-md);
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-md);
  }

  .post-content :global(li) {
    margin-bottom: var(--space-xs);
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: var(--space-sm);
    margin-left: 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-content :global(code) {
    background-color: var(--color-card-bg);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    background-color: var(--color-card-bg);
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-md);
  }

  .post-content :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-md) 0;
  }

  .post-content :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post-content :global(a:hover) {
    color: var(--color-secondary);
    text-decoration: underline;
  }

  /* Post footer */
  .post-footer {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .post-footer-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .back-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-secondary);
    text-decoration: none;
    font-size: var(--fs-body);
    font-weight: 500;
    transition: all var(--transition-fast);
    padding: var(--space-xs) 0;
    align-self: flex-start;
  }

  .back-arrow {
    transition: transform var(--transition-fast);
    display: inline-block;
  }

  .back-cta:hover {
    color: var(--color-primary);
  }

  .back-cta:hover .back-arrow {
    transform: translateX(-4px);
  }

  @media (max-width: 768px) {
    .blog-post {
      padding: var(--space-sm) var(--space-sm) var(--space-xs);
    }

    h1 {
      font-size: clamp(1.35rem, 6vw, 2rem);
    }
  }
</style>
