---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from "../components/SectionHeader.astro";
import { growthEntries } from '../config/articles';

const allPosts = Object.values(
  import.meta.glob<{ frontmatter: any; url: string }>('./growth/*.md', { eager: true })
);
const postMap = Object.fromEntries(
  allPosts.map(p => [p.url!.split('/').at(-1)!, p])
);

const entries = growthEntries.map(entry => {
  if (entry.type !== 'post') return entry;
  const post = postMap[entry.slug];
  if (!post) return null;
  const { frontmatter, url } = post;
  const date = new Date(frontmatter.date).toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric'
  });
  return {
    type: 'post' as const,
    href: url!,
    title: frontmatter.title,
    description: frontmatter.description,
    meta: `${date} · ${frontmatter.category ?? 'Article'}`,
  };
}).filter(Boolean);
---

<MainLayout title="The Hope - Growth & Learning" description="Learning notes, reflections, tutorials, and knowledge sharing">
  <div class="growth-header">
    <h1>Growth & Learning</h1>
    <p class="lead">A collection of learning notes, shared talks, and so on...</p>
  </div>

  <section class="learning-philosophy">
    <SectionHeader title="My Learning Philosophy" />
    <div class="philosophy-content">
      <p class="philosophy-statement">
        Curiosity is the engine behind pretty much everything I do - I learn things because
        I can't leave a question alone. And one of the things that makes me happiest is
        realizing I'm better at something than I was before - continuous learning is what
        keeps that happening.
      </p>
      <blockquote class="philosophy-quote">
        "The beautiful thing about learning is that nobody can take it away from you."
        <cite>- B.B. King</cite>
      </blockquote>
    </div>
  </section>

  <div class="section-divider">
    <div class="divider-line"></div>
    <div class="divider-icon">
      <i data-lucide="book"></i>
    </div>
    <div class="divider-line"></div>
  </div>

  <section class="posts-section">
    <SectionHeader title="Latest Posts" />
    <div class="writing-list">
      {entries.map(entry => {
        if (entry.type === 'coming-soon') return (
          <div class="entry is-disabled">
            <div class="entry-body">
              <span class="entry-meta">{entry.meta}</span>
              <h3 class="entry-title">{entry.title}</h3>
              <p class="entry-excerpt">{entry.description}</p>
            </div>
            <span class="entry-soon">Coming soon</span>
          </div>
        );
        return (
          <a href={entry.href} class="entry">
            <div class="entry-body">
              <span class="entry-meta">{entry.meta}</span>
              <h3 class="entry-title">{entry.title}</h3>
              <p class="entry-excerpt">{entry.description}</p>
            </div>
            <span class="entry-arrow" aria-hidden="true">→</span>
          </a>
        );
      })}
  </section>

</MainLayout>

<style>
  .growth-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .lead {
    font-size: 1.25rem;
    color: var(--color-secondary);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  section {
    margin-bottom: 4rem;
  }

  h2 {
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .learning-philosophy {
    max-width: 1000px;
    margin: 0 auto 4rem;
    line-height: 1.8;
  }

  .philosophy-content {
    max-width: 920px;
  }

  .philosophy-statement {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--color-text);
    line-height: 1.75;
    font-weight: 300;
    text-align: left;
    margin: 0 0 var(--space-lg);
  }

  .philosophy-quote {
    border-left: 2px solid var(--color-primary);
    padding-left: var(--space-md);
    margin: 0;
    font-style: italic;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  .philosophy-quote cite {
    display: block;
    margin-top: var(--space-xs);
    font-size: var(--fs-small);
    color: var(--color-text-faint);
    font-style: normal;
  }

  .section-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-xl) 0;
    gap: var(--space-md);
  }

  .divider-line {
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
    flex: 1;
    max-width: 200px;
  }

  .divider-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(var(--color-accent-rgb), 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .divider-icon i {
    width: 20px;
    height: 20px;
    color: var(--color-accent);
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }

  /* Editorial list rows */
  .writing-list {
    border-top: 1px solid var(--color-border);
  }

  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-md);
    margin: 0 calc(var(--space-sm) * -1);
    padding: var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: padding var(--transition-medium), background-color var(--transition-medium);
  }

  a.entry:hover {
    padding-left: calc(var(--space-sm) + var(--space-xs));
    background-color: var(--color-card-bg);
  }

  .entry-meta {
    display: block;
    font-size: var(--fs-small);
    color: var(--color-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .entry-title {
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    transition: color var(--transition-fast);
  }

  a.entry:hover .entry-title {
    color: var(--color-primary);
  }

  .entry-excerpt {
    margin: var(--space-xs) 0 0;
    line-height: 1.6;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
  }

  .entry-arrow {
    font-size: 1.5rem;
    color: var(--color-text-muted);
    transition: transform var(--transition-medium), color var(--transition-medium);
  }

  a.entry:hover .entry-arrow {
    color: var(--color-primary);
    transform: translateX(6px);
  }

  .entry.is-disabled {
    cursor: default;
  }

  .entry.is-disabled .entry-title,
  .entry.is-disabled .entry-excerpt {
    opacity: 0.55;
  }

  .entry-soon {
    font-size: var(--fs-small);
    color: var(--color-text-faint);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }


  @media (max-width: 768px) {
    .section-divider {
      margin: var(--space-lg) 0;
    }

    .divider-line {
      max-width: 100px;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .entry-arrow {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .divider-line {
      max-width: 60px;
    }

    .divider-icon {
      width: 32px;
      height: 32px;
    }

    .divider-icon i {
      width: 16px;
      height: 16px;
    }

    .entry {
      padding: var(--space-md) 0;
    }
  }
</style>
