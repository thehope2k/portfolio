---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="The Hope - Home">
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1>Welcome to my world of ideas.</h1>
        <p class="lead">Developer. Writer. Thinker.</p>
        <p class="tagline">Where logic meets imagination.</p>
      </div>

      <div class="hero-visual">
        <div class="abstract-art">
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <path fill="var(--color-primary)" d="M40,-65.5C53.2,-59.9,66.3,-52.3,74.4,-40.5C82.5,-28.7,85.6,-12.8,83.9,2.1C82.1,17,75.5,30.9,66.4,42.5C57.3,54.1,45.7,63.3,32.7,68.8C19.7,74.3,5.3,76,-8.2,73.5C-21.7,71,-34.3,64.3,-45.9,55.3C-57.5,46.3,-68.1,35,-73.2,21.5C-78.3,8,-77.9,-7.7,-73.1,-21.7C-68.3,-35.7,-59.1,-48,-47.1,-54.1C-35.1,-60.2,-20.3,-60.1,-5.4,-62.1C9.5,-64.1,26.8,-71.1,40,-65.5Z" transform="translate(100 100)" />
          </svg>
          <svg class="overlay" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <path fill="var(--color-secondary)" d="M47.7,-80.4C62.3,-71.3,75.1,-59.5,83.1,-44.8C91.1,-30.1,94.3,-12.6,91.6,3.9C88.9,20.4,80.3,35.8,69.5,49.1C58.7,62.4,45.7,73.5,30.6,78.9C15.5,84.3,-1.8,84,-17.8,79.2C-33.8,74.5,-48.5,65.3,-60.9,53.1C-73.3,40.9,-83.3,25.7,-86.9,8.7C-90.5,-8.3,-87.7,-27.1,-78.8,-41.8C-69.9,-56.5,-55,-67.1,-39.8,-75.7C-24.6,-84.3,-9.1,-90.9,5.2,-89.5C19.5,-88.1,33.1,-89.5,47.7,-80.4Z" transform="translate(100 100)" />
          </svg>
        </div>
      </div>
    </div>

    <div class="floating-nav">
      <a href="/portfolio/professional" class="nav-item">⇾ Professional</a>
      <a href="/portfolio/personal" class="nav-item">⇾ Personal</a>
      <a href="/portfolio/growth" class="nav-item">⇾ Growth</a>
    </div>

    <div class="scroll-cue">
      <span class="arrow-icon">↓</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <section class="featured-article">
    <div class="article-card">
      <div class="article-visual">
        <div class="learning-illustration">
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <path fill="var(--color-secondary)" opacity="0.2" d="M45.3,-51.2C58.3,-40.6,68.5,-25.1,70.8,-8.3C73.1,8.6,67.4,26.8,56.1,39.4C44.8,52,27.8,59,9.7,63.5C-8.4,68,-27.5,70,-42.7,61.8C-57.9,53.6,-69.1,35.2,-73.7,15.1C-78.3,-5,-76.2,-26.8,-65.4,-41.8C-54.6,-56.8,-35.1,-65,-16.7,-65.8C1.7,-66.6,32.3,-61.9,45.3,-51.2Z" transform="translate(100 100)" />
          </svg>
          <div class="icon-container">
            <div class="icon">💡</div>
          </div>
        </div>
      </div>
      <div class="article-content">
        <span class="article-tag">Featured</span>
        <h3 class="article-title">The Journey of Learning</h3>
        <p class="article-text">
          Learning is a continuous journey that never truly ends. In this piece, I reflect on my personal
          experiences with learning new technologies and skills, and how embracing the process of learning
          itself can be transformative.
        </p>
        <blockquote class="article-quote">
          <span class="quote-mark">⟪</span> Where logic meets imagination. <span class="quote-mark">⟫</span>
        </blockquote>
        <a href="/portfolio/personal/journey-of-learning" class="article-link">Read Featured Article</a>
      </div>
    </div>
  </section>

  <section class="intro">
    <h2>About This Site</h2>
    <p class="intro-text">
      This portfolio is divided into three main sections that represent different aspects of my life:
    </p>

    <div class="sections-grid">
      <div class="section-card professional">
        <div class="card-icon">🧑‍💼</div>
        <div class="card-content">
          <h3>Professional</h3>
          <p>
            My resume, skills, projects, and professional background. This section is designed for recruiters, 
            collaborators, or anyone interested in my technical abilities.
          </p>
          <div class="preview-content">
            Latest project → 'Portfolio Redesign'
          </div>
          <a href="/portfolio/professional" class="card-link">View Professional Profile</a>
        </div>
      </div>

      <div class="section-card personal">
        <div class="card-icon">✍️</div>
        <div class="card-content">
          <h3>Personal</h3>
          <p>
            A space for my creative writing, personal projects, and thoughts. Here I share stories, 
            reflections, and creative endeavors outside of my professional work.
          </p>
          <div class="preview-content">
            Latest writing → 'Lines of code, stories untold'
          </div>
          <a href="/portfolio/personal" class="card-link">Read My Writing</a>
        </div>
      </div>

      <div class="section-card growth">
        <div class="card-icon">🌱</div>
        <div class="card-content">
          <h3>Growth</h3>
          <p>
            Blog-style posts about my learning journey, technical tutorials, book notes, and reflections 
            on personal and professional development.
          </p>
          <div class="preview-content">
            Latest blog → 'Reflections on Progress'
          </div>
          <a href="/portfolio/growth" class="card-link">Explore My Learning</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    padding: 0;
    margin-bottom: 4rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--color-text);
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 30%, rgba(0, 191, 255, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(0, 255, 204, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    z-index: 2;
  }

  .hero-text {
    text-align: left;
    padding-right: 2rem;
  }

  h1 {
    font-size: var(--fs-h1);
    margin-bottom: 1.5rem;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(1.2rem, 3vw, 1.75rem);
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.05em;
  }

  .tagline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 2rem;
    position: relative;
    padding-left: 1.5rem;
  }

  .tagline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1rem;
    height: 1px;
    background: var(--color-primary);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .abstract-art {
    position: relative;
    width: 100%;
    max-width: 400px;
    height: auto;
  }

  .abstract-art svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 10px rgba(0, 191, 255, 0.15));
    animation: float 6s ease-in-out infinite, morph 15s ease-in-out infinite alternate;
  }

  .abstract-art svg.overlay {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0.5;
    filter: drop-shadow(0 0 10px rgba(0, 255, 204, 0.15));
    animation: float-reverse 8s ease-in-out infinite, morph-reverse 18s ease-in-out infinite alternate;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(2deg); }
  }

  @keyframes float-reverse {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(10px) rotate(-2deg); }
  }

  @keyframes morph {
    0% { transform: scale(1); }
    50% { transform: scale(1.05) skew(1deg, 1deg); }
    100% { transform: scale(0.95); }
  }

  @keyframes morph-reverse {
    0% { transform: scale(1); }
    50% { transform: scale(0.95) skew(-1deg, -1deg); }
    100% { transform: scale(1.05); }
  }

  .floating-nav {
    position: absolute;
    bottom: 5rem;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2rem);
    z-index: 3;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .nav-item {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1.1rem;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
  }

  .nav-item:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    color: var(--color-primary);
  }

  .scroll-cue {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: var(--color-text-muted);
    opacity: 0.7;
    animation: fade-in-out 2s ease-in-out infinite;
    z-index: 2; /* Lower z-index to ensure it's below the buttons */
  }

  .arrow-icon {
    display: block;
    font-size: 1.2rem; /* Smaller font size */
    color: var(--color-primary);
    margin-bottom: 0.25rem; /* Reduced margin */
  }

  .scroll-line {
    width: 1px;
    height: 2rem; /* Shorter line */
    background: linear-gradient(to bottom, var(--color-primary), transparent);
    margin: 0.25rem auto 0; /* Reduced margin */
  }

  @keyframes fade-in-out {
    0%, 100% { opacity: 0.3; transform: translateY(0) translateX(-50%); }
    50% { opacity: 0.7; transform: translateY(-3px) translateX(-50%); } /* Reduced vertical movement */
  }

  .intro {
    margin: 4rem 0 6rem;
  }

  .intro h2 {
    font-size: var(--fs-h2);
    margin-bottom: 1.5rem;
    color: var(--color-text);
    position: relative;
    display: inline-block;
  }

  .intro h2::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    width: 50%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary), transparent);
  }

  .intro-text {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    margin-top: 2rem;
  }

  .section-card {
    position: relative;
    display: flex;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--color-card-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .section-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.2) 100%);
    z-index: 1;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .section-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3), 0 0 15px var(--shadow-glow);
  }

  .section-card:hover::before {
    opacity: 1;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    font-size: 2rem;
    background-color: rgba(0, 0, 0, 0.2);
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.2));
    transition: all 0.3s ease;
  }

  .section-card:hover .card-icon {
    transform: scale(1.1);
  }

  .professional .card-icon {
    background: linear-gradient(135deg, rgba(0, 191, 255, 0.1) 0%, rgba(0, 191, 255, 0.2) 100%);
  }

  .personal .card-icon {
    background: linear-gradient(135deg, rgba(0, 255, 204, 0.1) 0%, rgba(0, 255, 204, 0.2) 100%);
  }

  .growth .card-icon {
    background: linear-gradient(135deg, rgba(255, 102, 0, 0.1) 0%, rgba(255, 102, 0, 0.2) 100%);
  }

  .card-content {
    padding: 1.75rem;
    flex: 1;
    position: relative;
    z-index: 2;
  }

  .section-card h3 {
    margin-bottom: 1rem;
    font-size: var(--fs-h3);
    color: var(--color-text);
    position: relative;
    display: inline-block;
  }

  .professional h3::after {
    content: '';
    position: absolute;
    bottom: -0.25rem;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--color-primary);
  }

  .personal h3::after {
    content: '';
    position: absolute;
    bottom: -0.25rem;
    left: 0;
    width: 30px;
    height: 2px;
    background: var(--color-secondary);
  }

  .growth h3::after {
    content: '';
    position: absolute;
    bottom: -0.25rem;
    left: 0;
    width: 30px;
    height: 2px;
    background: #ff6600;
  }

  .section-card p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.6;
    font-size: var(--fs-body);
  }

  .preview-content {
    font-size: var(--fs-small);
    padding: 0.75rem;
    margin-bottom: 1.5rem;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.03);
    border-left: 2px solid var(--color-primary);
    color: var(--color-text-muted);
  }

  .personal .preview-content {
    border-left-color: var(--color-secondary);
  }

  .growth .preview-content {
    border-left-color: #ff6600;
  }

  .card-link {
    display: inline-block;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 0;
    position: relative;
    transition: all 0.3s ease;
  }

  .card-link::after {
    content: ' →';
    opacity: 0;
    transform: translateX(-8px);
    display: inline-block;
    transition: all 0.3s ease;
  }

  .card-link:hover {
    color: var(--color-primary);
  }

  .personal .card-link:hover {
    color: var(--color-secondary);
  }

  .growth .card-link:hover {
    color: #ff6600;
  }

  .card-link:hover::after {
    opacity: 1;
    transform: translateX(4px);
  }

  /* Featured Article Styles */
  .featured-article {
    margin: 5rem 0;
  }

  .article-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 2fr;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--color-card-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @media (max-width: 600px) {
    .article-card {
      grid-template-columns: 1fr;
    }
  }

  .article-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2), 0 0 15px var(--shadow-glow);
  }

  .article-visual {
    position: relative;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.05) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 2rem;
  }

  .learning-illustration {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .learning-illustration svg {
    width: 100%;
    height: auto;
    max-width: 220px;
    filter: drop-shadow(0 0 10px rgba(0, 255, 204, 0.1));
    animation: float-gentle 8s ease-in-out infinite;
  }

  @keyframes float-gentle {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(2deg); }
  }

  .icon-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  .icon {
    font-size: 2.5rem;
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.2));
    animation: pulse-gentle 4s ease-in-out infinite;
  }

  @keyframes pulse-gentle {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.1); opacity: 1; }
  }

  .article-content {
    padding: 2.5rem;
    position: relative;
    z-index: 2;
    font-family: var(--font-alt);
  }

  .article-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background-color: rgba(0, 191, 255, 0.08);
    color: var(--color-primary);
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(0, 191, 255, 0.15);
    font-family: var(--font-alt);
  }

  .article-title {
    font-family: var(--font-alt);
    font-size: var(--fs-h3);
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .article-text {
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
    line-height: 1.8;
    font-family: var(--font-alt);
    font-size: var(--fs-body);
  }

  .article-quote {
    font-style: italic;
    padding: 0.75rem 1rem 0.75rem 1.5rem;
    margin-bottom: 1.75rem;
    border-left: 2px solid var(--color-primary);
    color: var(--color-text-muted);
    position: relative;
    font-family: var(--font-alt);
    line-height: 1.6;
    font-size: var(--fs-small);
  }

  .quote-mark {
    color: var(--color-primary);
    opacity: 0.7;
    font-weight: 300;
  }

  .article-link {
    display: inline-block;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 0;
    position: relative;
    transition: all 0.3s ease;
    font-family: var(--font-alt);
  }

  .article-link::after {
    content: ' →';
    opacity: 0;
    transform: translateX(-8px);
    display: inline-block;
    transition: all 0.3s ease;
  }

  .article-link:hover {
    color: var(--color-secondary);
  }

  .article-link:hover::after {
    opacity: 1;
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }

    .hero-text {
      padding-right: 0;
      order: 1;
    }

    .hero-visual {
      order: 0;
    }

    .tagline {
      display: inline-block;
      padding-left: 0;
    }

    .tagline::before {
      display: none;
    }

    .floating-nav {
      bottom: 4rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 80vh;
    }

    h1 {
      font-size: 2.5rem;
    }

    .lead {
      font-size: 1.25rem;
    }

    .tagline {
      font-size: 1.1rem;
    }

    .floating-nav {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      bottom: 6rem;
    }

    .nav-item {
      width: 200px;
      text-align: center;
    }

    .scroll-cue {
      display: none; /* Hide scroll-cue on mobile to prevent overlap */
    }

    .section-card {
      flex-direction: column;
    }

    .card-icon {
      width: 100%;
      padding: 1rem 0;
    }

    .intro h2 {
      font-size: 2rem;
    }

    .article-card {
      grid-template-columns: 1fr;
    }

    .article-visual {
      height: 180px;
      padding: 1rem;
    }

    .learning-illustration svg {
      max-width: 160px;
    }

    .icon {
      font-size: 2rem;
    }

    .article-content {
      padding: 1.75rem;
    }

    .article-title {
      font-size: 1.6rem;
      margin-bottom: 1rem;
    }

    .article-text {
      font-size: 1rem;
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }

    .article-quote {
      padding: 0.5rem 0.75rem 0.5rem 1.25rem;
      margin-bottom: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-content {
      padding: 1rem;
    }

    .abstract-art {
      max-width: 220px;
    }

    .nav-item {
      width: 180px;
      font-size: 1rem;
    }

    .sections-grid {
      grid-template-columns: 1fr;
    }

    .featured-article {
