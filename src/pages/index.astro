---
import MainLayout from '../layouts/MainLayout.astro';
import SectionCard from '../components/SectionCard.astro';
import { latestContent } from '../config/latest-content';
---

<MainLayout title="The Hope - Home">
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1>Welcome to my world of ideas.</h1>
        <p class="lead">Developer. Writer. Thinker.</p>
        <p class="tagline">Where logic meets imagination.</p>
      </div>

      <div class="hero-visual">
        <div class="abstract-art">
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <path fill="var(--color-primary)" d="M40,-65.5C53.2,-59.9,66.3,-52.3,74.4,-40.5C82.5,-28.7,85.6,-12.8,83.9,2.1C82.1,17,75.5,30.9,66.4,42.5C57.3,54.1,45.7,63.3,32.7,68.8C19.7,74.3,5.3,76,-8.2,73.5C-21.7,71,-34.3,64.3,-45.9,55.3C-57.5,46.3,-68.1,35,-73.2,21.5C-78.3,8,-77.9,-7.7,-73.1,-21.7C-68.3,-35.7,-59.1,-48,-47.1,-54.1C-35.1,-60.2,-20.3,-60.1,-5.4,-62.1C9.5,-64.1,26.8,-71.1,40,-65.5Z" transform="translate(100 100)" />
          </svg>
          <svg class="overlay" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <path fill="var(--color-secondary)" d="M47.7,-80.4C62.3,-71.3,75.1,-59.5,83.1,-44.8C91.1,-30.1,94.3,-12.6,91.6,3.9C88.9,20.4,80.3,35.8,69.5,49.1C58.7,62.4,45.7,73.5,30.6,78.9C15.5,84.3,-1.8,84,-17.8,79.2C-33.8,74.5,-48.5,65.3,-60.9,53.1C-73.3,40.9,-83.3,25.7,-86.9,8.7C-90.5,-8.3,-87.7,-27.1,-78.8,-41.8C-69.9,-56.5,-55,-67.1,-39.8,-75.7C-24.6,-84.3,-9.1,-90.9,5.2,-89.5C19.5,-88.1,33.1,-89.5,47.7,-80.4Z" transform="translate(100 100)" />
          </svg>
        </div>
      </div>
    </div>

    <div class="floating-nav">
      <a href="/portfolio/professional" class="nav-item">⇾ Professional</a>
      <a href="/portfolio/personal" class="nav-item">⇾ Personal</a>
      <a href="/portfolio/growth" class="nav-item">⇾ Growth</a>
    </div>

    <div class="scroll-cue">
      <span class="arrow-icon">↓</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <section class="intro">
    <h2>About This Site</h2>
    <p class="intro-text">
      This portfolio is divided into three main sections that represent different aspects of my life:
    </p>

    <div class="sections-grid">
      <SectionCard
        title="Professional"
        description="My resume, skills, projects, and professional background. This section is designed for recruiters, collaborators, or anyone interested in my technical abilities."
        icon="briefcase"
        previewText={`Latest project → '${latestContent.professional.title}'`}
        buttonText="View Professional Profile"
        buttonLink="/portfolio/professional"
        variant="professional"
      />

      <SectionCard
        title="Personal"
        description="A space for my creative writing, personal projects, and thoughts. Here I share stories, reflections, and creative endeavors outside of my professional work."
        icon="pen-tool"
        previewText={`Latest writing → '${latestContent.personal.title}'`}
        buttonText="Read My Writing"
        buttonLink="/portfolio/personal"
        variant="personal"
      />

      <SectionCard
        title="Growth"
        description="Blog-style posts about my learning journey, technical tutorials, book notes, and reflections on personal and professional development."
        icon="sprout"
        previewText={`Latest blog → '${latestContent.growth.title}'`}
        buttonText="Explore My Learning"
        buttonLink="/portfolio/growth"
        variant="growth"
      />
    </div>
  </section>
</MainLayout>

<script>
  // Initialize Lucide icons
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    padding: 0;
    margin-bottom: 3rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--color-text);
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 30%, rgba(0, 191, 255, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(0, 255, 204, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
    z-index: 2;
  }

  .hero-text {
    text-align: left;
    padding-right: var(--space-lg);
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 3.5rem); /* Improved responsive scaling */
    margin-bottom: var(--space-sm); /* Reduced for better mobile spacing */
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(1rem, 2.5vw, 1.75rem); /* Improved responsive scaling */
    color: var(--color-text);
    margin-bottom: var(--space-sm); /* Reduced for better mobile spacing */
    font-weight: 300;
    letter-spacing: 0.05em;
  }

  .tagline {
    font-size: clamp(0.85rem, 1.8vw, 1.25rem); /* Improved responsive scaling */
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: var(--space-md); /* Reduced from space-lg for better mobile spacing */
    position: relative;
    padding-left: 1.5rem;
  }

  .tagline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1rem;
    height: 1px;
    background: var(--color-primary);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .abstract-art {
    position: relative;
    width: 100%;
    max-width: min(350px, 100%); /* Reduced from 400px for better scaling on small screens */
    height: auto;
  }

  .abstract-art svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 10px rgba(0, 191, 255, 0.15));
    animation: float 6s ease-in-out infinite, morph 15s ease-in-out infinite alternate;
  }

  .abstract-art svg.overlay {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0.5;
    filter: drop-shadow(0 0 10px rgba(0, 255, 204, 0.15));
    animation: float-reverse 8s ease-in-out infinite, morph-reverse 18s ease-in-out infinite alternate;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(2deg); }
  }

  @keyframes float-reverse {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(10px) rotate(-2deg); }
  }

  @keyframes morph {
    0% { transform: scale(1); }
    50% { transform: scale(1.05) skew(1deg, 1deg); }
    100% { transform: scale(0.95); }
  }

  @keyframes morph-reverse {
    0% { transform: scale(1); }
    50% { transform: scale(0.95) skew(-1deg, -1deg); }
    100% { transform: scale(1.05); }
  }

  .floating-nav {
    position: absolute;
    bottom: 4rem;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: clamp(0.5rem, 1.5vw, 2rem); /* Further reduced gap for better mobile layout */
    z-index: 3;
    padding: 0 1rem;
    box-sizing: border-box;
    flex-wrap: wrap; /* Allow buttons to wrap on very small screens */
  }

  .nav-item {
    color: var(--color-text);
    text-decoration: none;
    font-size: clamp(0.9rem, 1.5vw, 1.1rem); /* Responsive font size */
    padding: 0.5rem 1rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    margin-bottom: 0.5rem; /* Add margin to ensure spacing when stacked */
  }

  .nav-item:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    color: var(--color-primary);
  }

  .scroll-cue {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: var(--color-text-muted);
    opacity: 0.7;
    animation: fade-in-out 2s ease-in-out infinite;
    z-index: 2; /* Lower z-index to ensure it's below the buttons */
  }

  .arrow-icon {
    display: block;
    font-size: 1.2rem; /* Smaller font size */
    color: var(--color-primary);
    margin-bottom: 0.25rem; /* Reduced margin */
  }

  .scroll-line {
    width: 1px;
    height: 2rem; /* Shorter line */
    background: linear-gradient(to bottom, var(--color-primary), transparent);
    margin: 0.25rem auto 0; /* Reduced margin */
  }

  @keyframes fade-in-out {
    0%, 100% { opacity: 0.3; transform: translateY(0) translateX(-50%); }
    50% { opacity: 0.7; transform: translateY(-3px) translateX(-50%); } /* Reduced vertical movement */
  }

  .intro {
    margin: var(--space-xl) 0;
    position: relative;
  }

  .intro::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(0, 191, 255, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(0, 255, 204, 0.03) 0%, transparent 50%);
    pointer-events: none;
    z-index: -1;
  }

  .intro h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-md);
    color: var(--color-text);
    position: relative;
    display: inline-block;
  }

  .intro h2::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    width: 50%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary), transparent);
  }

  .intro-text {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    max-width: 800px;
    margin-bottom: var(--space-xl);
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .section-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    padding: var(--space-lg);
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: calc(var(--card-index, 0) * 0.1s);
    text-align: center;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .professional {
    --card-index: 1;
  }

  .personal {
    --card-index: 2;
  }

  .growth {
    --card-index: 3;
  }

  .section-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100%),
      radial-gradient(circle at 100% 100%, rgba(0, 0, 0, 0.08) 0%, transparent 50%);
    z-index: 1;
    opacity: 0.8;
    transition: opacity 0.4s ease;
  }

  .section-card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 30px;
    height: 30px;
    z-index: 1;
    opacity: 0.2;
    transition: opacity 0.3s ease;
  }

  .professional::after {
    background: radial-gradient(circle at top right, rgba(0, 191, 255, 0.4), transparent 70%);
  }

  .personal::after {
    background: radial-gradient(circle at top right, rgba(0, 255, 204, 0.4), transparent 70%);
  }

  .growth::after {
    background: radial-gradient(circle at top right, rgba(255, 102, 0, 0.4), transparent 70%);
  }

  .section-card:hover::after {
    opacity: 0.4;
  }

  .section-card:hover {
    transform: translateY(-5px);
    box-shadow:
      0 10px 20px rgba(0, 0, 0, 0.15);
  }

  .section-card {
    border-left: 1px solid rgba(255, 255, 255, 0.05);
  }

  .professional {
    border-top: 2px solid rgba(0, 191, 255, 0.7);
  }

  .personal {
    border-top: 2px solid rgba(0, 255, 204, 0.7);
  }

  .growth {
    border-top: 2px solid rgba(255, 102, 0, 0.7);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: var(--space-lg);
    position: relative;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .card-icon i {
    width: 32px;
    height: 32px;
    stroke-width: 1.5;
    transition: all 0.3s ease;
  }

  .section-card:hover .card-icon i {
    transform: translateY(-3px);
  }

  .professional .card-icon i {
    color: rgba(0, 191, 255, 1);
    stroke: rgba(0, 191, 255, 1);
  }

  .personal .card-icon i {
    color: rgba(0, 255, 204, 1);
    stroke: rgba(0, 255, 204, 1);
  }

  .growth .card-icon i {
    color: rgba(255, 102, 0, 1);
    stroke: rgba(255, 102, 0, 1);
  }

  .card-content {
    flex: 1;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-card h3 {
    margin-bottom: var(--space-md);
    font-size: calc(var(--fs-h3) * 0.9);
    color: var(--color-text);
    position: relative;
    font-weight: 500;
    letter-spacing: 0;
  }

  .professional h3 {
    color: rgba(0, 191, 255, 0.85);
  }

  .personal h3 {
    color: rgba(0, 255, 204, 0.85);
  }

  .growth h3 {
    color: rgba(255, 102, 0, 0.85);
  }

  .section-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    line-height: 1.9;
    font-size: var(--fs-body);
    max-width: 42em;
    font-weight: 300;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .preview-content {
    font-size: var(--fs-small);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-md);
    border-radius: 4px;
    background-color: transparent;
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: 300;
    width: 100%;
    text-align: center;
  }

  .professional .preview-content {
    color: rgba(0, 191, 255, 0.6);
  }

  .personal .preview-content {
    color: rgba(0, 255, 204, 0.6);
  }

  .growth .preview-content {
    color: rgba(255, 102, 0, 0.6);
  }

  .card-button {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 400;
    padding: 0.6rem 1.5rem;
    transition: all 0.3s ease;
    margin-top: auto;
    position: relative;
    overflow: hidden;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  .card-button::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .professional .card-button {
    color: rgba(0, 191, 255, 0.7);
  }

  .personal .card-button {
    color: rgba(0, 255, 204, 0.7);
  }

  .growth .card-button {
    color: rgba(255, 102, 0, 0.7);
  }

  .card-button:hover {
    color: var(--color-text);
  }

  .professional .card-button:hover {
    color: rgba(0, 191, 255, 0.9);
  }

  .personal .card-button:hover {
    color: rgba(0, 255, 204, 0.9);
  }

  .growth .card-button:hover {
    color: rgba(255, 102, 0, 0.9);
  }

  .card-button:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }


  /* Responsive breakpoints */
  @media (min-width: 1440px) {
    .hero-content {
      gap: var(--space-xl);
    }
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-xl);
    }

    .hero-text {
      padding-right: 0;
      order: 1;
    }

    .hero-visual {
      order: 0;
    }

    .tagline {
      display: inline-block;
      padding-left: 0;
    }

    .tagline::before {
      display: none;
    }

    .floating-nav {
      bottom: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 80vh;
      padding-top: var(--space-lg); /* Add top padding for better spacing */
      padding-bottom: var(--space-xl); /* Add bottom padding for better spacing */
    }

    .hero-content {
      padding: var(--space-md);
      gap: var(--space-md); /* Reduced gap for better mobile spacing */
    }

    .hero-text {
      padding: 0 var(--space-sm); /* Add horizontal padding for better text containment */
    }

    .floating-nav {
      flex-direction: column;
      align-items: center;
      gap: var(--space-xs);
      bottom: var(--space-lg); /* Reduced from space-xl for better positioning */
      padding: 0 var(--space-md); /* Increased horizontal padding */
    }

    .nav-item {
      width: min(200px, 90%);
      text-align: center;
      min-height: 44px; /* Maintain minimum touch target size */
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.75rem; /* Increased from 0.5rem for better spacing */
    }

    .scroll-cue {
      display: none; /* Hide scroll-cue on mobile to prevent overlap */
    }

    .sections-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .section-card {
      padding: var(--space-md);
    }

    .card-icon {
      margin-bottom: var(--space-sm);
    }

    .section-card h3 {
      font-size: calc(var(--fs-h3) * 0.85);
    }

    .section-card p {
      margin-bottom: var(--space-sm);
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 75vh; /* Further reduced height for small screens */
      padding-top: var(--space-md); /* Reduced top padding */
      padding-bottom: var(--space-lg); /* Reduced bottom padding */
    }

    .hero-content {
      padding: var(--space-sm);
      gap: var(--space-md); /* Reduced gap for better spacing */
    }

    .hero-text {
      padding: 0; /* Remove padding on very small screens */
    }

    h1 {
      font-size: clamp(1.5rem, 3.5vw, 2.5rem); /* Further reduced for small screens */
      margin-bottom: var(--space-xs); /* Smaller margin */
    }

    .lead {
      font-size: clamp(0.9rem, 2vw, 1.5rem); /* Further reduced for small screens */
      margin-bottom: var(--space-xs); /* Smaller margin */
    }

    .tagline {
      font-size: clamp(0.8rem, 1.5vw, 1rem); /* Further reduced for small screens */
      margin-top: var(--space-sm); /* Smaller margin */
    }

    .abstract-art {
      max-width: min(220px, 90%);
    }

    .floating-nav {
      bottom: var(--space-md); /* Reduced bottom position */
    }

    .nav-item {
      width: min(180px, 90%);
      padding: 0.4rem 0.8rem; /* Slightly reduced padding */
      margin-bottom: 0.5rem; /* Reduced margin */
    }

    .sections-grid {
      grid-template-columns: 1fr;
    }

    .preview-content {
      padding: var(--space-xs);
      margin-bottom: var(--space-sm);
    }
  }

  /* Extra small devices */
  @media (max-width: 320px) {
    .hero {
      min-height: 65vh; /* Further reduced height for extra small screens */
      padding-top: var(--space-xs); /* Minimal top padding */
      padding-bottom: var(--space-sm); /* Minimal bottom padding */
    }

    .hero-content {
      padding: var(--space-xs);
      gap: var(--space-xs); /* Minimal gap */
    }

    h1 {
      font-size: clamp(1.2rem, 2.8vw, 1.8rem); /* Smallest size for tiny screens */
      margin-bottom: 0.3rem; /* Minimal margin */
    }

    .lead {
      font-size: clamp(0.85rem, 1.8vw, 1.2rem); /* Smaller size for tiny screens */
      margin-bottom: 0.3rem; /* Minimal margin */
    }

    .tagline {
      font-size: clamp(0.75rem, 1.4vw, 0.9rem); /* Smaller size for tiny screens */
      margin-top: 0.5rem; /* Minimal margin */
    }

    .abstract-art {
      max-width: min(160px, 85%); /* Further reduced size */
    }

    .floating-nav {
      bottom: 1rem; /* Fixed bottom position */
    }

    .nav-item {
      width: min(140px, 85%);
      padding: 0.3rem 0.6rem; /* Minimal padding */
      margin-bottom: 0.3rem; /* Minimal margin */
      font-size: 0.8rem; /* Smaller font size */
    }

    .intro {
      margin: var(--space-md) 0; /* Reduced margin */
    }

    .intro-text {
      margin-bottom: var(--space-md); /* Reduced margin */
    }

    .sections-grid {
      gap: var(--space-sm); /* Reduced gap */
    }
  }
</style>
