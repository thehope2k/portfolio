---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="The Hope - Home">
  <section class="hero">
    <div class="hero-inner">
      <h1>Welcome to my world of ideas.</h1>
      <div class="lead-row">
        <span class="lead">Developer. Writer. Thinker.</span>
        <span class="lead-sep" aria-hidden="true">—</span>
        <span class="tagline">Where logic meets imagination.</span>
      </div>
      <p class="signature" id="signature" aria-live="polite">If you have a chance, be kind.</p>
    </div>

    <nav class="hero-explore" aria-label="Explore sections">
      <a href="/professional">Professional</a>
      <span aria-hidden="true">·</span>
      <a href="/personal">Personal</a>
      <span aria-hidden="true">·</span>
      <a href="/growth">Growth</a>
    </nav>
  </section>
</MainLayout>

<script>
  const phrases = [
    "If you have a chance, be kind.",
    "Live a little.",
    "Be present.",
    "Stay curious.",
  ];
  const el = document.getElementById('signature');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduceMotion) {
    let i = 0;
    setInterval(() => {
      el.style.opacity = '0';
      setTimeout(() => {
        i = (i + 1) % phrases.length;
        el.textContent = phrases[i];
        el.style.opacity = '';
      }, 600);
    }, 4500);
  }
</script>


<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: var(--color-text);
    min-height: 70vh;
  }

  .hero-inner {
    width: 100%;
    max-width: var(--container-max-width);
    margin: auto 0;
    display: flex;
    flex-direction: column;
    animation: heroFade 0.7s ease-out both;
  }

  @keyframes heroFade {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    margin: 0 0 var(--space-md);
    color: var(--color-text);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .lead-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem var(--space-sm);
  }

  .lead {
    font-size: clamp(1.05rem, 2.5vw, 1.6rem);
    color: var(--color-text);
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .lead-sep {
    font-size: clamp(1.05rem, 2.5vw, 1.6rem);
    color: var(--color-text-faint);
    font-weight: 300;
  }

  .tagline {
    font-size: clamp(0.9rem, 1.8vw, 1.15rem);
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 300;
  }

  .signature {
    margin: var(--space-lg) 0 0;
    text-align: left;
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--color-text-muted);
    font-style: italic;
    letter-spacing: 0.01em;
    transition: opacity 0.6s ease;
  }

  /* Mobile-only section links — positioned at bottom of hero */
  .hero-explore {
    display: none;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding: 0;
    font-size: 0.9rem;
  }

  .hero-explore a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .hero-explore a:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .hero-explore span {
    color: var(--color-text-faint);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 77vh;
    }

    .hero-inner {
      padding: var(--space-lg) 0;
    }

    .hero-explore {
      display: flex;
    }
  }

  /* iPad and tablet portrait - NO links, just shorter hero */
  @media (min-width: 769px) and (max-width: 1024px) {
    .hero {
      min-height: 65vh;
    }
  }

  @media (max-width: 600px) {
    .lead-sep {
      display: none;
    }

    .tagline {
      flex-basis: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 78vh;
    }

    .hero h1 {
      font-size: clamp(1.75rem, 9vw, 2.5rem);
    }
  }

</style>
