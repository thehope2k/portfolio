---
import MainLayout from '../layouts/MainLayout.astro';
import SectionCard from '../components/SectionCard.astro';
import { latestContent } from '../config/latest-content';
---

<MainLayout title="The Hope - Home">
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1>Welcome to my world of ideas.</h1>
        <p class="lead">Developer. Writer. Thinker.</p>
        <p class="tagline">Where logic meets imagination.</p>
      </div>

      <div class="hero-visual">
        <div class="abstract-art">
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <path fill="var(--color-primary)" d="M50,-65C66.2,-56.8,81.8,-44.6,86.7,-29.1C91.7,-13.5,86.1,5.3,78.2,21.8C70.3,38.3,60.2,52.3,46.7,62.2C33.2,72,16.6,77.5,0.2,77.2C-16.2,77,-32.4,71,-45.4,60.8C-58.4,50.7,-68.2,36.3,-74.8,19.7C-81.3,3,-84.7,-15.9,-78.3,-31.2C-72,-46.5,-56,-58.2,-40,-65.5C-24,-72.8,-8,-75.7,7.2,-74.9C22.3,-74.1,33.7,-73.2,50,-65Z" transform="translate(100 100)">
              <animate attributeName="d" dur="15s" repeatCount="indefinite" values="
                M50,-65C66.2,-56.8,81.8,-44.6,86.7,-29.1C91.7,-13.5,86.1,5.3,78.2,21.8C70.3,38.3,60.2,52.3,46.7,62.2C33.2,72,16.6,77.5,0.2,77.2C-16.2,77,-32.4,71,-45.4,60.8C-58.4,50.7,-68.2,36.3,-74.8,19.7C-81.3,3,-84.7,-15.9,-78.3,-31.2C-72,-46.5,-56,-58.2,-40,-65.5C-24,-72.8,-8,-75.7,7.2,-74.9C22.3,-74.1,33.7,-73.2,50,-65Z;

                M54.3,-67.4C69.2,-56.7,79.5,-39.2,83.5,-20.9C87.5,-2.6,85.2,16.5,76.8,31.8C68.4,47.1,53.9,58.6,38.1,65.9C22.3,73.2,5.2,76.3,-12.4,74.8C-30,73.3,-48.1,67.2,-61.4,54.8C-74.7,42.4,-83.2,23.7,-83.9,4.6C-84.6,-14.6,-77.5,-34.2,-64.6,-45.8C-51.7,-57.4,-32.9,-61,-15.2,-65.9C2.5,-70.8,19.2,-77,35.9,-76.1C52.6,-75.2,69.3,-67.2,54.3,-67.4Z;

                M50,-65C66.2,-56.8,81.8,-44.6,86.7,-29.1C91.7,-13.5,86.1,5.3,78.2,21.8C70.3,38.3,60.2,52.3,46.7,62.2C33.2,72,16.6,77.5,0.2,77.2C-16.2,77,-32.4,71,-45.4,60.8C-58.4,50.7,-68.2,36.3,-74.8,19.7C-81.3,3,-84.7,-15.9,-78.3,-31.2C-72,-46.5,-56,-58.2,-40,-65.5C-24,-72.8,-8,-75.7,7.2,-74.9C22.3,-74.1,33.7,-73.2,50,-65Z"
              />
            </path>
          </svg>
          <div class="glow-effect"></div>
        </div>
      </div>
    </div>

    <div class="floating-nav">
      <a href="/portfolio/professional" class="nav-item">⇾ Professional</a>
      <a href="/portfolio/personal" class="nav-item">⇾ Personal</a>
      <a href="/portfolio/growth" class="nav-item">⇾ Growth</a>
    </div>

    <div class="scroll-cue">
      <span class="arrow-icon">↓</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <section class="intro">
    <h2>About This Site</h2>
    <p class="intro-text">
      This portfolio is divided into three main sections that represent different aspects of my life:
    </p>

    <div class="sections-grid">
      <SectionCard
        title="Professional"
        description="My resume, skills, projects, and professional background. This section is designed for recruiters, collaborators, or anyone interested in my technical abilities."
        icon="briefcase"
        previewText={`Latest project → '${latestContent.professional.title}'`}
        buttonText="View Professional Profile"
        buttonLink="/portfolio/professional"
        variant="professional"
      />

      <SectionCard
        title="Personal"
        description="A space for my creative writing, personal projects, and thoughts. Here I share stories, reflections, and creative endeavors outside of my professional work."
        icon="pen-tool"
        previewText={`Latest writing → '${latestContent.personal.title}'`}
        buttonText="Read My Writing"
        buttonLink="/portfolio/personal"
        variant="personal"
      />

      <SectionCard
        title="Growth"
        description="Blog-style posts about my learning journey, technical tutorials, book notes, and reflections on personal and professional development."
        icon="sprout"
        previewText={`Latest blog → '${latestContent.growth.title}'`}
        buttonText="Explore My Learning"
        buttonLink="/portfolio/growth"
        variant="growth"
      />
    </div>
  </section>
</MainLayout>


<style>
  .hero {
    position: relative;
    min-height: 80vh;
    padding: 0;
    margin-bottom: 3rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--color-text);
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-alt) 100%);
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 30%, rgba(0, 191, 255, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(0, 255, 204, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .hero-text {
    text-align: left;
    padding-right: var(--space-lg);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 3.5rem); /* Improved responsive scaling */
    margin-bottom: var(--space-sm); /* Reduced for better mobile spacing */
    background: linear-gradient(120deg, var(--color-primary) 20%, var(--color-secondary) 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 10px rgba(var(--color-primary-rgb), 0.2);
  }

  .lead {
    font-size: clamp(1rem, 2.5vw, 1.75rem); /* Improved responsive scaling */
    color: var(--color-text);
    margin-bottom: var(--space-sm); /* Reduced for better mobile spacing */
    font-weight: 300;
    letter-spacing: 0.05em;
  }

  .tagline {
    font-size: clamp(0.85rem, 1.8vw, 1.25rem); /* Improved responsive scaling */
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: var(--space-md); /* Reduced from space-lg for better mobile spacing */
    position: relative;
    padding-left: 1.5rem;
  }

  .tagline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1rem;
    height: 1px;
    background: var(--color-primary);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .abstract-art {
    position: relative;
    width: 100%;
    max-width: min(350px, 100%);
    height: auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .abstract-art svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 15px rgba(var(--color-primary-rgb), 0.2));
    animation: float 8s ease-in-out infinite;
    z-index: 1;
  }

  .glow-effect {
    position: absolute;
    width: 80%;
    height: 80%;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      rgba(var(--color-primary-rgb), 0.15) 0%,
      rgba(var(--color-secondary-rgb), 0.05) 50%,
      transparent 70%
    );
    filter: blur(20px);
    opacity: 0.8;
    z-index: 0;
    animation: pulse 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.1); opacity: 0.6; }
  }

  .floating-nav {
    position: absolute;
    bottom: 4rem;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: clamp(0.5rem, 1.5vw, 2rem); /* Further reduced gap for better mobile layout */
    z-index: 3;
    padding: 0 1rem;
    box-sizing: border-box;
    flex-wrap: wrap; /* Allow buttons to wrap on very small screens */
  }

  .nav-item {
    color: var(--color-text);
    text-decoration: none;
    font-size: clamp(0.9rem, 1.5vw, 1.1rem); /* Responsive font size */
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.3s ease;
    margin-bottom: 0.5rem; /* Add margin to ensure spacing when stacked */
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-item:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15), 0 0 10px rgba(var(--color-primary-rgb), 0.2);
    color: var(--color-primary);
    border-color: rgba(var(--color-primary-rgb), 0.3);
  }

  .scroll-cue {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: var(--color-text-muted);
    opacity: 0.7;
    animation: fade-in-out 2s ease-in-out infinite;
    z-index: 2; /* Lower z-index to ensure it's below the buttons */
  }

  .arrow-icon {
    display: block;
    font-size: 1.2rem; /* Smaller font size */
    color: var(--color-primary);
    margin-bottom: 0.25rem; /* Reduced margin */
  }

  .scroll-line {
    width: 1px;
    height: 2rem; /* Shorter line */
    background: linear-gradient(to bottom, var(--color-primary), transparent);
    margin: 0.25rem auto 0; /* Reduced margin */
  }

  @keyframes fade-in-out {
    0%, 100% { opacity: 0.3; transform: translateY(0) translateX(-50%); }
    50% { opacity: 0.7; transform: translateY(-3px) translateX(-50%); } /* Reduced vertical movement */
  }

  .intro {
    margin: var(--space-xl) 0;
    position: relative;
  }

  .intro::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(0, 191, 255, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(0, 255, 204, 0.03) 0%, transparent 50%);
    pointer-events: none;
    z-index: -1;
  }

  .intro h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-md);
    color: var(--color-text);
    position: relative;
    display: inline-block;
  }

  .intro h2::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    width: 50%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary), transparent);
  }

  .intro-text {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    max-width: 800px;
    margin-bottom: var(--space-xl);
  }

  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-lg); /* Reduced gap */
    margin-top: var(--space-lg); /* Reduced margin */
    position: relative;
  }

  /* Subtle background connection between cards */
  .sections-grid::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      radial-gradient(circle at 30% 50%, rgba(var(--color-primary-rgb), 0.02) 0%, transparent 70%),
      radial-gradient(circle at 70% 50%, rgba(var(--color-secondary-rgb), 0.02) 0%, transparent 70%);
    z-index: 0;
    opacity: 0.5;
  }

  .section-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    padding: var(--space-md); /* Reduced padding */
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: calc(var(--card-index, 0) * 0.1s);
    text-align: center;
    transform-origin: center; /* For smooth rotation */
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .professional {
    --card-index: 1;
    transform: translateY(-5px) rotate(-1deg); /* Slight staggering */
    z-index: 3;
  }

  .personal {
    --card-index: 2;
    z-index: 2;
  }

  .growth {
    --card-index: 3;
    transform: translateY(5px) rotate(1deg); /* Slight staggering */
    z-index: 1;
  }

  .section-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100%),
      radial-gradient(circle at 100% 100%, rgba(0, 0, 0, 0.08) 0%, transparent 50%);
    z-index: 1;
    opacity: 0.8;
    transition: opacity 0.4s ease;
  }

  .section-card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 30px;
    height: 30px;
    z-index: 1;
    opacity: 0.2;
    transition: opacity 0.3s ease;
  }

  .professional::after {
    background: radial-gradient(circle at top right, rgba(0, 191, 255, 0.4), transparent 70%);
  }

  .personal::after {
    background: radial-gradient(circle at top right, rgba(0, 255, 204, 0.4), transparent 70%);
  }

  .growth::after {
    background: radial-gradient(circle at top right, rgba(230, 145, 56, 0.4), transparent 70%);
  }

  .section-card:hover::after {
    opacity: 0.4;
  }

  .section-card:hover {
    transform: translateY(-5px) rotate(0deg) !important; /* Override the staggering on hover */
    box-shadow:
      0 10px 20px rgba(0, 0, 0, 0.15);
    z-index: 10 !important; /* Ensure hovered card is on top */
  }

  /* Border styles are already included in the main .section-card rule */

  .professional {
    border-top: 2px solid rgba(0, 191, 255, 0.7);
  }

  .personal {
    border-top: 2px solid rgba(0, 255, 204, 0.7);
  }

  .growth {
    border-top: 2px solid rgba(230, 145, 56, 0.7);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: var(--space-lg);
    position: relative;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .card-icon i {
    width: 32px;
    height: 32px;
    stroke-width: 1.5;
    transition: all 0.3s ease;
  }

  .section-card:hover .card-icon i {
    transform: translateY(-3px);
  }

  .professional .card-icon i {
    color: rgba(0, 191, 255, 1);
    stroke: rgba(0, 191, 255, 1);
  }

  .personal .card-icon i {
    color: rgba(0, 255, 204, 1);
    stroke: rgba(0, 255, 204, 1);
  }

  .growth .card-icon i {
    color: rgba(230, 145, 56, 1);
    stroke: rgba(230, 145, 56, 1);
  }

  .card-content {
    flex: 1;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: space-between; /* Distribute space evenly */
  }

  .section-card h3 {
    margin-bottom: var(--space-xs); /* Reduced margin */
    font-size: calc(var(--fs-h3) * 0.9);
    color: var(--color-text);
    position: relative;
    font-weight: 500;
    letter-spacing: 0;
  }

  .professional h3 {
    color: rgba(0, 191, 255, 0.85);
  }

  .personal h3 {
    color: rgba(0, 255, 204, 0.85);
  }

  .growth h3 {
    color: rgba(230, 145, 56, 0.85);
  }

  .section-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs); /* Reduced margin */
    line-height: 1.6; /* Reduced line height */
    font-size: var(--fs-body);
    max-width: 42em;
    font-weight: 300;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .preview-content {
    font-size: var(--fs-small);
    padding: var(--space-xs) var(--space-sm);
    margin-bottom: var(--space-xs); /* Reduced margin */
    border-radius: 4px;
    background-color: transparent;
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: 300;
    width: 100%;
    text-align: center;
  }

  .professional .preview-content {
    color: rgba(0, 191, 255, 0.6);
  }

  .personal .preview-content {
    color: rgba(0, 255, 204, 0.6);
  }

  .growth .preview-content {
    color: rgba(230, 145, 56, 0.6);
  }

  .card-button {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 400;
    padding: 0.6rem 1.5rem;
    transition: all 0.3s ease;
    margin-top: var(--space-sm); /* Fixed margin instead of auto */
    position: relative;
    overflow: hidden;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }

  .card-button::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .professional .card-button {
    color: rgba(0, 191, 255, 0.7);
  }

  .personal .card-button {
    color: rgba(0, 255, 204, 0.7);
  }

  .growth .card-button {
    color: rgba(230, 145, 56, 0.7);
  }

  .card-button:hover {
    color: var(--color-text);
  }

  .professional .card-button:hover {
    color: rgba(0, 191, 255, 0.9);
  }

  .personal .card-button:hover {
    color: rgba(0, 255, 204, 0.9);
  }

  .growth .card-button:hover {
    color: rgba(230, 145, 56, 0.9);
  }

  .card-button:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }


  /* Responsive breakpoints */
  @media (min-width: 1440px) {
    .hero-content {
      gap: var(--space-xl);
    }
  }

  @media (max-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-xl);
    }

    .hero-text {
      padding-right: 0;
      order: 1;
    }

    .hero-visual {
      order: 0;
    }

    .tagline {
      display: inline-block;
      padding-left: 0;
    }

    .tagline::before {
      display: none;
    }

    .floating-nav {
      bottom: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 80vh;
      padding-top: var(--space-lg); /* Add top padding for better spacing */
      padding-bottom: var(--space-xl); /* Add bottom padding for better spacing */
    }

    .hero-content {
      padding: var(--space-md);
      gap: var(--space-md); /* Reduced gap for better mobile spacing */
    }

    .hero-text {
      padding: 0 var(--space-sm); /* Add horizontal padding for better text containment */
    }

    .floating-nav {
      flex-direction: column;
      align-items: center;
      gap: var(--space-xs);
      bottom: var(--space-lg); /* Reduced from space-xl for better positioning */
      padding: 0 var(--space-md); /* Increased horizontal padding */
    }

    .nav-item {
      width: min(200px, 90%);
      text-align: center;
      min-height: 44px; /* Maintain minimum touch target size */
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.75rem; /* Increased from 0.5rem for better spacing */
    }

    .scroll-cue {
      display: none; /* Hide scroll-cue on mobile to prevent overlap */
    }

    .sections-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .section-card {
      padding: var(--space-md);
    }

    .card-icon {
      margin-bottom: var(--space-sm);
    }

    .section-card h3 {
      font-size: calc(var(--fs-h3) * 0.85);
    }

    .section-card p {
      margin-bottom: var(--space-xs); /* Keep consistent with desktop */
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 75vh; /* Further reduced height for small screens */
      padding-top: var(--space-md); /* Reduced top padding */
      padding-bottom: var(--space-lg); /* Reduced bottom padding */
    }

    .hero-content {
      padding: var(--space-sm);
      gap: var(--space-md); /* Reduced gap for better spacing */
    }

    .hero-text {
      padding: 0; /* Remove padding on very small screens */
    }

    h1 {
      font-size: clamp(1.5rem, 3.5vw, 2.5rem); /* Further reduced for small screens */
      margin-bottom: var(--space-xs); /* Smaller margin */
    }

    .lead {
      font-size: clamp(0.9rem, 2vw, 1.5rem); /* Further reduced for small screens */
      margin-bottom: var(--space-xs); /* Smaller margin */
    }

    .tagline {
      font-size: clamp(0.8rem, 1.5vw, 1rem); /* Further reduced for small screens */
      margin-top: var(--space-sm); /* Smaller margin */
    }

    .abstract-art {
      max-width: min(220px, 90%);
