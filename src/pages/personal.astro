---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { personalSlugs } from '../config/articles';

const allPosts = Object.values(
  import.meta.glob<{ frontmatter: any; url: string }>('./personal/*.md', { eager: true })
);
const postMap = Object.fromEntries(
  allPosts.map(p => [p.url!.split('/').at(-1)!, p])
);

const articles = personalSlugs
  .filter(slug => postMap[slug])
  .map(slug => {
    const { frontmatter, url } = postMap[slug];
    const date = new Date(frontmatter.date).toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric'
    });
    return { slug, url, title: frontmatter.title, description: frontmatter.description, date, category: frontmatter.category ?? 'Essay' };
  });
---

<MainLayout title="The Hope - Personal Writing" description="Creative writing, personal projects, and thoughts">
  <div class="personal-header">
    <h1>Personal Writing</h1>
    <p class="lead">A space for messy writing and unfiltered opinions</p>
  </div>

  <section class="writing-philosophy">
    <SectionHeader title="My Writing Philosophy" />
    <div class="philosophy-content">
      <p class="philosophy-statement">
        Writing is where I put the things I can't say out loud — a quiet place to grumble
        about someone or something I'd never say to their face. Sometimes it's just me
        trying to think more clearly. And every now and then, almost by accident,
        something here turns out to be useful to someone else.
      </p>
      <blockquote class="philosophy-quote">
        “Writing is thinking. To write well is to think clearly. That's why it's so hard.”
        <cite>— David McCullough</cite>
      </blockquote>
    </div>
  </section>

  <div class="section-divider">
    <div class="divider-line"></div>
    <div class="divider-icon">
      <i data-lucide="book-open"></i>
    </div>
    <div class="divider-line"></div>
  </div>

  <section class="writings-section">
    <SectionHeader title="Latest Writings" />
    <div class="writing-list">
      {articles.map(({ url, title, description, date, category }) => (
        <a href={url} class="entry">
          <div class="entry-body">
            <span class="entry-meta">{date} · {category}</span>
            <h3 class="entry-title">{title}</h3>
            <p class="entry-excerpt">{description}</p>
          </div>
          <span class="entry-arrow" aria-hidden="true">→</span>
        </a>
      ))}


    </div>
  </section>
</MainLayout>

<style>
  .personal-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .lead {
    font-size: 1.25rem;
    color: var(--color-secondary);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  section {
    margin-bottom: 4rem;
  }

  h2 {
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .writing-philosophy {
    max-width: 1000px;
    margin: 0 auto 4rem;
    line-height: 1.8;
  }

  .philosophy-content {
    max-width: 920px;
  }

  .philosophy-statement {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--color-text);
    line-height: 1.75;
    font-weight: 300;
    text-align: left;
    margin: 0 0 var(--space-lg);
  }

  .philosophy-quote {
    border-left: 2px solid var(--color-primary);
    padding-left: var(--space-md);
    margin: 0;
    font-style: italic;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  .philosophy-quote cite {
    display: block;
    margin-top: var(--space-xs);
    font-size: var(--fs-small);
    color: var(--color-text-faint);
    font-style: normal;
  }

  .section-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-xl) 0;
    gap: var(--space-md);
  }

  .divider-line {
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
    flex: 1;
    max-width: 200px;
  }

  .divider-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(var(--color-primary-rgb), 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .divider-icon i {
    width: 20px;
    height: 20px;
    color: var(--color-primary);
    stroke: var(--color-primary);
    stroke-width: 1.5;
  }

  /* Editorial list rows */
  .writing-list {
    border-top: 1px solid var(--color-border);
  }

  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-md);
    margin: 0 calc(var(--space-sm) * -1);
    padding: var(--space-md) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    transition: padding var(--transition-medium), background-color var(--transition-medium);
  }

  .entry:hover {
    padding-left: calc(var(--space-sm) + var(--space-xs));
    background-color: var(--color-card-bg);
  }

  .entry-meta {
    display: block;
    font-size: var(--fs-small);
    color: var(--color-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .entry-title {
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    transition: color var(--transition-fast);
  }

  .entry:hover .entry-title {
    color: var(--color-primary);
  }

  .entry-excerpt {
    margin: var(--space-xs) 0 0;
    line-height: 1.6;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
  }

  .entry-arrow {
    font-size: 1.5rem;
    color: var(--color-text-muted);
    transition: transform var(--transition-medium), color var(--transition-medium);
  }

  .entry:hover .entry-arrow {
    color: var(--color-primary);
    transform: translateX(6px);
  }

  @media (max-width: 768px) {
    .section-divider {
      margin: var(--space-lg) 0;
    }

    .divider-line {
      max-width: 100px;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .entry-arrow {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .divider-line {
      max-width: 60px;
    }

    .divider-icon {
      width: 32px;
      height: 32px;
    }

    .divider-icon i {
      width: 16px;
      height: 16px;
    }

    .entry {
      padding: var(--space-md) 0;
    }
  }
</style>
