---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResumeModal from '../components/ResumeModal.astro';
---

<MainLayout title="The Hope - Professional Life" description="Professional profile, skills, projects, and contact information">
  <div class="professional-header">
    <h1>Professional Life</h1>
    <p class="lead">This is me, in professional mode</p>
  </div>

  <section class="about-section">
    <SectionHeader title="About Me" />
    <div class="values-timeline">
      <div class="value-item" data-aos="fade-up" data-aos-delay="100">
        <div class="value-icon attitude">
          <i data-lucide="smile"></i>
        </div>
        <div class="value-content card">
          <h3 class="value-title">Attitude First</h3>
          <p class="value-description">
            Skills can be learned—attitude shows up first. I bring curiosity, honesty,
            and good energy into whatever I do, whether that’s squashing a bug or teaming up under pressure.
          </p>
        </div>
      </div>

      <div class="value-item" data-aos="fade-up" data-aos-delay="200">
        <div class="value-icon responsibility">
          <i data-lucide="shield"></i>
        </div>
        <div class="value-content card">
          <h3 class="value-title">Responsibility</h3>
          <p class="value-description">
            If I say I’ll do something, I mean it. Responsibility is self-respect:
            owning my part, communicating clearly, and delivering even when no one’s watching.
          </p>
        </div>
      </div>

      <div class="value-item" data-aos="fade-up" data-aos-delay="300">
        <div class="value-icon professionalism">
          <i data-lucide="code"></i>
        </div>
        <div class="value-content card">
          <h3 class="value-title">Professionalism</h3>
          <p class="value-description">
            Engineering is a craft that demands excellence. Clean code isn’t a preference—it’s a principle:
            best practices, steady improvement, and standards my future self will thank me for.
          </p>
        </div>
      </div>

      <div class="value-item" data-aos="fade-up" data-aos-delay="400">
        <div class="value-icon growth">
          <i data-lucide="sprout"></i>
        </div>
        <div class="value-content card">
          <h3 class="value-title">Growth & Sharing</h3>
          <p class="value-description">
            No gatekeeping, no egos. I believe in the mix—30% under our skill level (to teach),
            30% at our edge (for growth), and 30% beyond (for inspiration).
            Oops, I missed 10%. Oh wait—that’s room for laziness and luck!
          </p>
        </div>
      </div>
    </div>

    <div class="resume-download">
      <Button
        text="Get My Resume (PDF)"
        href="#"
        variant="outline"
        ariaLabel="View my resume"
        class="resume-button"
      >
        <i data-lucide="file-down" slot="icon-before"></i>
      </Button>
    </div>

    <!-- Resume Modal -->
    <ResumeModal />
  </section>

  <section class="education-section">
    <SectionHeader title="Education" />
    <div class="education-timeline">
      <div class="education-item" data-aos="fade-up" data-aos-delay="100">
        <div class="education-icon">
          <i data-lucide="graduation-cap"></i>
          <span class="education-year">2015-2018</span>
        </div>
        <div class="education-content card">
          <h3 class="education-title">Vinh Phuc High School for the Gifted</h3>
          <p class="education-major">Major: Informatics</p>
          <p class="education-description">Where I first learned about programming with C++, and quit at the Dynamic Programming chapter.
            I still haven't fully understood DP to this day yet.
          </p>
        </div>
      </div>

      <div class="education-item" data-aos="fade-up" data-aos-delay="200">
        <div class="education-icon">
          <i data-lucide="building-2"></i>
          <span class="education-year">2018-2022</span>
        </div>
        <div class="education-content card">
          <h3 class="education-title">Hanoi University of Science, VNU</h3>
          <p class="education-major">Major: Computer Science</p>
          <p class="education-description">Where I cut classes to play Chinese Chess. Luckily, I graduated anyway.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="skills-section">
    <SectionHeader title="Skills & Technologies" />
    <p class="skills-intro">
      I love building distributed systems that scale without falling apart — and stay
      maintainable enough that future-me doesn't resent past-me. The rest below is what
      I reach for to make that happen.
    </p>
    <div class="skills-categories">
      <div class="skill-category highlight">
        <h3>Distributed Systems</h3>
        <div class="skills-list">
          <Tag text="System Design" variant="primary" />
          <Tag text="Microservices" variant="primary" />
          <Tag text="Event-Driven Architecture" variant="primary" />
          <Tag text="Observability" variant="primary" />
          <Tag text="Fault Tolerance" variant="primary" />
          <Tag text="Scalability" variant="primary" />
        </div>
      </div>

      <div class="skill-category">
        <h3>Backend</h3>
        <div class="skills-list">
          <Tag text="Java" variant="primary" />
          <Tag text="Node.js" variant="primary" />
          <Tag text="Python" variant="primary" />
          <Tag text="RESTful APIs" variant="primary" />
          <Tag text="Kafka" variant="primary" />
          <Tag text="OAuth2 / OIDC" variant="primary" />
        </div>
      </div>

      <div class="skill-category">
        <h3>Data & Storage</h3>
        <div class="skills-list">
          <Tag text="PostgreSQL" variant="primary" />
          <Tag text="MySQL" variant="primary" />
          <Tag text="MongoDB" variant="primary" />
          <Tag text="Redis" variant="primary" />
        </div>
      </div>

      <div class="skill-category">
        <h3>Infrastructure</h3>
        <div class="skills-list">
          <Tag text="Docker" variant="primary" />
          <Tag text="AWS" variant="primary" />
          <Tag text="Azure" variant="primary" />
          <Tag text="CI/CD" variant="primary" />
          <Tag text="Git" variant="primary" />
        </div>
      </div>

      <div class="skill-category">
        <h3>Frontend</h3>
        <div class="skills-list">
          <Tag text="React" variant="primary" />
          <Tag text="TypeScript" variant="primary" />
          <Tag text="JavaScript" variant="primary" />
          <Tag text="HTML/CSS" variant="primary" />
        </div>
      </div>
    </div>
  </section>

  <section class="projects-section">
    <SectionHeader title="Projects" />
    <div class="projects-grid">
      <ProjectCard
        title="Minimalist Agent"
        description="A minimalist coding agent harness — a clean, focused desktop chat interface for reading, editing, and operating on your codebase with an AI assistant."
        technologies={["TypeScript", "Electron", "AI Agents", "Node.js"]}
        githubUrl="https://github.com/thehope2k/minimalist-agent"
        demoDisabled={true}
      />

      <ProjectCard
        title="Agent Compose"
        description="A framework for composing and orchestrating multiple AI agents — wiring specialized agents together to collaborate on larger, multi-step tasks."
        technologies={["Spec", "AI Agents", "Orchestration"]}
        githubUrl="https://github.com/agentcompose"
        demoDisabled={true}
      />

      <ProjectCard
        title="Chinese Chess AI Engine"
        description="A powerful AI engine for Chinese Chess that uses advanced algorithms to analyze and play the game."
        technologies={["Java", "AI", "Algorithms", "Game Theory"]}
        comingSoon={true}
      />
    </div>
  </section>

  <section class="contact-section">
    <SectionHeader title="Contact" />
    <p>Feel free to reach out to me through any of the following channels:</p>

    <div class="contact-links">
      <a href="mailto:nguyenthehop2000@gmail.com" class="contact-link">
        <span class="contact-icon">
          <i data-lucide="mail"></i>
        </span>
        <span>nguyenthehop2000@gmail.com</span>
      </a>

      <a href="https://github.com/thehope2k" target="_blank" rel="noopener noreferrer" class="contact-link">
        <span class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.66-.22.66-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.16.58.67.48A10.02 10.02 0 0 0 22 12c0-5.52-4.48-10-10-10z"/></svg>
        </span>
        <span>GitHub</span>
      </a>

      <a href="https://www.linkedin.com/in/the-hope/" target="_blank" rel="noopener noreferrer" class="contact-link">
        <span class="contact-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </span>
        <span>LinkedIn</span>
      </a>

      <a href="https://zalo.me/0979465164" target="_blank" rel="noopener noreferrer" class="contact-link">
        <span class="contact-icon">
          <i data-lucide="message-circle"></i>
        </span>
        <span>Zalo</span>
      </a>
    </div>
  </section>
</MainLayout>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    // Get the resume button
    const resumeButton = document.querySelector('.resume-button');

    // Add click event listener to open the modal
    if (resumeButton) {
      resumeButton.addEventListener('click', (e) => {
        e.preventDefault(); // Prevent default anchor behavior
        if (typeof window.openResumeModal === 'function') {
          window.openResumeModal();
        }
      });
    }
  });
</script>

<style>
  .professional-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .lead {
    font-size: 1.25rem;
    color: var(--color-secondary);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  section {
    margin-bottom: 2.5rem;
  }

  h2 {
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .values-timeline {
    /* Restore the four-color identity, scoped to this section only */
    --color-accent: #e69138;
    --color-accent-rgb: 230, 145, 56;
    --color-neutral: #c084fc;
    --color-neutral-rgb: 192, 132, 252;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .values-timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 24px;
    width: 3px;
    background: linear-gradient(to bottom, 
      var(--color-primary), 
      var(--color-secondary),
      var(--color-accent),
      var(--color-neutral));
    opacity: 0.6;
    border-radius: var(--radius-full);
    filter: blur(1px);
    box-shadow: 0 0 8px rgba(var(--color-primary-rgb), 0.3);
  }

  .value-item {
    display: flex;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-md);
  }

  .value-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-card-bg);
    border: 2px solid var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(var(--color-primary-rgb), 0.3);
    position: relative;
    z-index: 2;
  }

  .value-icon.attitude {
    border-color: var(--color-primary);
    box-shadow: 0 0 15px rgba(var(--color-primary-rgb), 0.3);
  }

  .value-icon.responsibility {
    border-color: var(--color-secondary);
    box-shadow: 0 0 15px rgba(var(--color-secondary-rgb), 0.3);
  }

  .value-icon.professionalism {
    border-color: var(--color-accent);
    box-shadow: 0 0 15px rgba(var(--color-accent-rgb), 0.3);
  }

  .value-icon.growth {
    border-color: var(--color-neutral);
    box-shadow: 0 0 15px rgba(var(--color-neutral-rgb), 0.3);
  }

  .value-icon i {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
    stroke: var(--color-primary);
    stroke-width: 1.5;
  }

  .value-icon.attitude i {
    color: var(--color-primary);
    stroke: var(--color-primary);
  }

  .value-icon.responsibility i {
    color: var(--color-secondary);
    stroke: var(--color-secondary);
  }

  .value-icon.professionalism i {
    color: var(--color-accent);
    stroke: var(--color-accent);
  }

  .value-icon.growth i {
    color: var(--color-neutral);
    stroke: var(--color-neutral);
  }

  .value-content {
    flex: 1;
    padding: var(--space-md);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
    border-top: 3px solid transparent;
  }

  .value-item:nth-child(1) .value-content {
    border-top-color: var(--color-primary);
  }

  .value-item:nth-child(2) .value-content {
    border-top-color: var(--color-secondary);
  }

  .value-item:nth-child(3) .value-content {
    border-top-color: var(--color-accent);
  }

  .value-item:nth-child(4) .value-content {
    border-top-color: var(--color-neutral);
  }

  .value-content:hover {
    transform: translateY(-2px);
  }

  .value-title {
    font-family: var(--font-alt);
    font-size: var(--fs-h3);
    margin-bottom: var(--space-xs);
  }

  .value-item:nth-child(1) .value-title {
    color: var(--color-primary);
  }

  .value-item:nth-child(2) .value-title {
    color: var(--color-secondary);
  }

  .value-item:nth-child(3) .value-title {
    color: var(--color-accent);
  }

  .value-item:nth-child(4) .value-title {
    color: var(--color-neutral);
  }

  .value-description {
    font-family: var(--font-alt);
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .resume-download {
    margin-top: 2rem;
    text-align: center;
  }

  :global(.btn.resume-button) {
    background-color: var(--color-primary);
    color: #0a0c0e;
    border: none;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 0.9rem 2rem;
    font-size: 1.05rem;
    border-radius: var(--radius-md);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium), background-color var(--transition-medium);
    box-shadow: 0 8px 24px rgba(var(--color-primary-rgb), 0.25);
  }

  :global(.btn.resume-button::after) {
    display: none;
  }

  :global(.btn.resume-button svg) {
    color: #0a0c0e;
    margin-right: var(--space-xs);
  }

  :global(.btn.resume-button:hover) {
    transform: translateY(-3px);
    background-color: #5cc8fa;
    box-shadow: 0 12px 30px rgba(var(--color-primary-rgb), 0.4);
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background-color: #0b5ed7;
  }

  .skills-intro {
    max-width: 820px;
    margin: 0 auto var(--space-lg);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.7;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .skills-categories {
    display: flex;
    flex-direction: column;
    max-width: 820px;
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
  }

  .skill-category {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: var(--space-lg);
    align-items: start;
    padding: var(--space-lg) var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .skill-category h3 {
    margin: 0;
    padding-top: 0.3rem;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .skill-category.highlight h3 {
    color: var(--color-primary);
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: center;
    justify-content: flex-start;
  }

  /* Using the unified tag styles from global.css */

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  /* Project card styles are handled by ProjectCard.astro component */

  .contact-section {
    margin-bottom: 4rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-lg);
    transition: all var(--transition-medium);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(170deg, rgba(0, 191, 255, 0.35) 0%, rgba(0, 191, 255, 0.06) 50%, rgba(255,255,255,0.04) 100%) border-box;
    border: 1px solid transparent;
    font-size: var(--fs-body);
  }

  .contact-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18), 0 0 12px rgba(var(--color-primary-rgb), 0.1);
    color: var(--color-primary);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(170deg, rgba(0, 191, 255, 0.6) 0%, rgba(0, 191, 255, 0.12) 50%, rgba(255,255,255,0.06) 100%) border-box;
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(var(--color-primary-rgb), 0.08);
    box-sizing: border-box;
    flex-shrink: 0;
    transition: all var(--transition-medium);
  }

  .contact-icon i {
    width: 18px;
    height: 18px;
    color: var(--color-primary);
    stroke: var(--color-primary);
    stroke-width: 1.5;
    transition: all var(--transition-medium);
  }

  .contact-icon svg {
    width: 18px;
    height: 18px;
    color: var(--color-primary);
    transition: all var(--transition-medium);
  }

  .contact-link:hover .contact-icon {
    background-color: rgba(var(--color-primary-rgb), 0.15);
  }

  .education-section {
    margin-bottom: 2.5rem;
  }

  .education-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .education-timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 24px;
    width: 3px;
    background: linear-gradient(to bottom, 
      var(--color-primary), 
      var(--color-secondary));
    opacity: 0.6;
    border-radius: var(--radius-full);
    filter: blur(1px);
    box-shadow: 0 0 8px rgba(var(--color-primary-rgb), 0.3);
  }

  .education-item {
    display: flex;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-md);
  }

  .education-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-card-bg);
    border: 2px solid var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(var(--color-primary-rgb), 0.3);
    position: relative;
    z-index: 2;
    flex-direction: column;
  }

  .education-icon i {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
    stroke: var(--color-primary);
    stroke-width: 1.5;
  }

  .education-year {
    position: absolute;
    top: -25px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    background-color: rgba(var(--color-primary-rgb), 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(var(--color-primary-rgb), 0.2);
  }

  .education-content {
    flex: 1;
    padding: var(--space-md);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
  }

  .education-content:hover {
    transform: translateY(-2px);
  }

  .education-title {
    font-family: var(--font-alt);
    font-size: var(--fs-h3);
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .education-major {
    font-family: var(--font-alt);
    font-size: var(--fs-body);
    color: var(--color-secondary);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .education-description {
    font-family: var(--font-alt);
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Laptop screen adjustments */
  @media (min-width: 1024px) {
    .values-timeline {
      gap: calc(var(--space-lg) * 0.8);
