---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResumeModal from '../components/ResumeModal.astro';
---

<MainLayout title="The Hope - Professional Life" description="Professional profile, skills, projects, and contact information">
  <div class="professional-header">
    <h1>Professional Life</h1>
    <p class="lead">My skills, projects, and professional background</p>
  </div>

  <section class="about-section">
    <SectionHeader title="About Me" />
    <div class="values-timeline">
      <div class="value-item" data-aos="fade-up" data-aos-delay="100">
        <div class="value-icon attitude">
          <i data-lucide="smile"></i>
        </div>
        <div class="value-content card">
          <h3 class="value-title">Attitude First</h3>
          <p class="value-description">
            Skills can be learned—attitude shows up first. I bring curiosity, honesty,
            and good energy into whatever I do, whether that’s squashing a bug or teaming up under pressure.
          </p>
        </div>
      </div>

      <div class="value-item" data-aos="fade-up" data-aos-delay="200">
        <div class="value-icon responsibility">
          <i data-lucide="shield"></i>
        </div>
        <div class="value-content card">
          <h3 class="value-title">Responsibility</h3>
          <p class="value-description">
            If I say I’ll do something, I mean it. Responsibility is self-respect:
            owning my part, communicating clearly, and delivering even when no one’s watching.
          </p>
        </div>
      </div>

      <div class="value-item" data-aos="fade-up" data-aos-delay="300">
        <div class="value-icon professionalism">
          <i data-lucide="code"></i>
        </div>
        <div class="value-content card">
          <h3 class="value-title">Professionalism</h3>
          <p class="value-description">
            Engineering is a craft that demands excellence. Clean code isn’t a preference—it’s a principle:
            best practices, steady improvement, and standards my future self will thank me for.
        </div>
      </div>

      <div class="value-item" data-aos="fade-up" data-aos-delay="400">
        <div class="value-icon growth">
          <i data-lucide="sprout"></i>
        </div>
        <div class="value-content card">
          <h3 class="value-title">Growth & Sharing</h3>
          <p class="value-description">
            No gatekeeping, no egos. I believe in the mix—30% under our skill level (to teach),
            30% at our edge (for growth), and 30% beyond (for inspiration).
            Oops, I missed 10%. Oh wait—that’s room for laziness and luck!
          </p>
        </div>
      </div>
    </div>

    <div class="resume-download">
      <Button
        text="Get My Resume (PDF)"
        href="#"
        variant="outline"
        ariaLabel="View my resume"
        class="resume-button"
      >
        <i data-lucide="file-down" slot="icon-before"></i>
      </Button>
    </div>

    <!-- Resume Modal -->
    <ResumeModal />
  </section>

  <section class="education-section">
    <SectionHeader title="Education" />
    <div class="education-timeline">
      <div class="education-item" data-aos="fade-up" data-aos-delay="100">
        <div class="education-icon">
          <i data-lucide="graduation-cap"></i>
          <span class="education-year">2015-2018</span>
        </div>
        <div class="education-content card">
          <h3 class="education-title">Vinh Phuc High School for the Gifted</h3>
          <p class="education-major">Major: Informatics</p>
          <p class="education-description">Where I first learned about programming with C++, and quit at the Dynamic Programming chapter.
            I still haven't fully understood DP to this day yet.
          </p>
        </div>
      </div>

      <div class="education-item" data-aos="fade-up" data-aos-delay="200">
        <div class="education-icon">
          <i data-lucide="building-2"></i>
          <span class="education-year">2018-2022</span>
        </div>
        <div class="education-content card">
          <h3 class="education-title">Hanoi University of Science, VNU</h3>
          <p class="education-major">Major: Computer Science</p>
          <p class="education-description">Where I cut classes to play Chinese Chess. Luckily, I graduated anyway.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="skills-section">
    <SectionHeader title="Skills & Technologies" />
    <div class="skills-categories">
      <div class="skill-category">
        <h3>Frontend</h3>
        <div class="skills-list">
          <Tag text="HTML/CSS" variant="primary" />
          <Tag text="JavaScript" variant="primary" />
          <Tag text="TypeScript" variant="primary" />
          <Tag text="React" variant="primary" />
          <Tag text="Responsive Design" variant="primary" />
        </div>
      </div>

      <div class="skill-category">
        <h3>Backend</h3>
        <div class="skills-list">
          <Tag text="Java" variant="primary" />
          <Tag text="Node.js" variant="primary" />
          <Tag text="Python" variant="primary" />
          <Tag text="RESTful APIs" variant="primary" />
          <Tag text="Microservices" variant="primary" />
          <Tag text="Kafka" variant="primary" />
          <Tag text="OAuth2 / OIDC" variant="primary" />
        </div>
      </div>

      <div class="skill-category">
        <h3>Databases</h3>
        <div class="skills-list">
          <Tag text="MySQL" variant="primary" />
          <Tag text="PostgreSQL" variant="primary" />
          <Tag text="MongoDB" variant="primary" />
          <Tag text="Redis" variant="primary" />
        </div>
      </div>

      <div class="skill-category">
        <h3>Tools & Others</h3>
        <div class="skills-list">
          <Tag text="Git" variant="primary" />
          <Tag text="Docker" variant="primary" />
          <Tag text="AWS" variant="primary" />
          <Tag text="CI/CD" variant="primary" />
          <Tag text="Agile/Scrum" variant="primary" />
          <Tag text="Testing" variant="primary" />
        </div>
      </div>
    </div>
  </section>

  <section class="projects-section">
    <SectionHeader title="Projects" />
    <div class="projects-grid">
      <ProjectCard
        title="Chinese Chess Online"
        description="An online platform for playing Chinese Chess with real-time multiplayer support. Built with React, Java, and PostgreSQL."
        technologies={["React", "Java", "PostgreSQL", "WebSocket"]}
        githubUrl="https://github.com/thehope2k/cchess-online"
        demoUrl="https://project1-demo.example.com"
      />

      <ProjectCard
        title="Chinese Chess AI Engine"
        description="A powerful AI engine for Chinese Chess that uses advanced algorithms to analyze and play the game."
        technologies={["Java", "AI", "Algorithms", "Game Theory"]}
        githubUrl="https://github.com/thehope2k/cchess-ai"
        demoUrl="https://project2-demo.example.com"
      />

      <ProjectCard
        title="Unnamed Project"
        description="A mysterious project currently in stealth mode. All I can say is that it involves cutting-edge technology and might just change the way we think about software development."
        technologies={["Mystery", "Innovation", "Coming Soon"]}
        githubUrl="https://github.com/thehope2k/unnamed-project"
        demoUrl="https://project3-demo.example.com"
      />
    </div>
  </section>

  <section class="contact-section">
    <SectionHeader title="Contact" />
    <p>Feel free to reach out to me through any of the following channels:</p>

    <div class="contact-links">
      <a href="mailto:nguyenthehop2000@gmail.com" class="contact-link">
        <span class="contact-icon">
          <i data-lucide="mail"></i>
        </span>
        <span>nguyenthehop2000@gmail.com</span>
      </a>

      <a href="https://github.com/thehope2k" target="_blank" rel="noopener noreferrer" class="contact-link">
        <span class="contact-icon">
          <i data-lucide="github"></i>
        </span>
        <span>GitHub</span>
      </a>

      <a href="https://linkedin.com/in/hop-nguyen-0b3284129/" target="_blank" rel="noopener noreferrer" class="contact-link">
        <span class="contact-icon">
          <i data-lucide="linkedin"></i>
        </span>
        <span>LinkedIn</span>
      </a>

      <a href="https://zalo.me/0979465164" target="_blank" rel="noopener noreferrer" class="contact-link">
        <span class="contact-icon">
          <i data-lucide="message-circle"></i>
        </span>
        <span>Zalo</span>
      </a>
    </div>
  </section>
</MainLayout>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    // Get the resume button
    const resumeButton = document.querySelector('.resume-button');

    // Add click event listener to open the modal
    if (resumeButton) {
      resumeButton.addEventListener('click', (e) => {
        e.preventDefault(); // Prevent default anchor behavior
        if (typeof window.openResumeModal === 'function') {
          window.openResumeModal();
        }
      });
    }
  });
</script>

<style>
  .professional-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .lead {
    font-size: 1.25rem;
    color: var(--color-secondary);
  }

  section {
    margin-bottom: 2.5rem;
  }

  h2 {
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .values-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .values-timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 24px;
    width: 3px;
    background: linear-gradient(to bottom, 
      var(--color-primary), 
      var(--color-secondary),
      var(--color-accent),
      var(--color-neutral));
    opacity: 0.6;
    border-radius: var(--radius-full);
    filter: blur(1px);
    box-shadow: 0 0 8px rgba(var(--color-primary-rgb), 0.3);
  }

  .value-item {
    display: flex;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-md);
  }

  .value-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-card-bg);
    border: 2px solid var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(var(--color-primary-rgb), 0.3);
    position: relative;
    z-index: 2;
  }

  .value-icon.attitude {
    border-color: var(--color-primary);
    box-shadow: 0 0 15px rgba(var(--color-primary-rgb), 0.3);
  }

  .value-icon.responsibility {
    border-color: var(--color-secondary);
    box-shadow: 0 0 15px rgba(var(--color-secondary-rgb), 0.3);
  }

  .value-icon.professionalism {
    border-color: var(--color-accent);
    box-shadow: 0 0 15px rgba(var(--color-accent-rgb), 0.3);
  }

  .value-icon.growth {
    border-color: var(--color-neutral);
    box-shadow: 0 0 15px rgba(var(--color-neutral-rgb), 0.3);
  }

  .value-icon i {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
    stroke: var(--color-primary);
    stroke-width: 1.5;
  }

  .value-icon.attitude i {
    color: var(--color-primary);
    stroke: var(--color-primary);
  }

  .value-icon.responsibility i {
    color: var(--color-secondary);
    stroke: var(--color-secondary);
  }

  .value-icon.professionalism i {
    color: var(--color-accent);
    stroke: var(--color-accent);
  }

  .value-icon.growth i {
    color: var(--color-neutral);
    stroke: var(--color-neutral);
  }

  .value-content {
    flex: 1;
    padding: var(--space-md);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
    border-top: 3px solid transparent;
  }

  .value-item:nth-child(1) .value-content {
    border-top-color: var(--color-primary);
  }

  .value-item:nth-child(2) .value-content {
    border-top-color: var(--color-secondary);
  }

  .value-item:nth-child(3) .value-content {
    border-top-color: var(--color-accent);
  }

  .value-item:nth-child(4) .value-content {
    border-top-color: var(--color-neutral);
  }

  .value-content:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .value-title {
    font-family: var(--font-alt);
    font-size: var(--fs-h3);
    margin-bottom: var(--space-xs);
  }

  .value-item:nth-child(1) .value-title {
    color: var(--color-primary);
  }

  .value-item:nth-child(2) .value-title {
    color: var(--color-secondary);
  }

  .value-item:nth-child(3) .value-title {
    color: var(--color-accent);
  }

  .value-item:nth-child(4) .value-title {
    color: var(--color-neutral);
  }

  .value-description {
    font-family: var(--font-alt);
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .resume-download {
    margin-top: 2rem;
    text-align: center;
  }

  .resume-button {
    background-color: #0F172A;
    color: var(--color-text);
    border: 2.5px solid;
    border-image: linear-gradient(to right, var(--color-primary), var(--color-secondary)) 1;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.85rem 1.8rem;
    font-size: 1.05rem;
    position: relative;
    overflow: hidden;
    transition: all var(--transition-medium);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15), 0 0 8px rgba(var(--color-primary-rgb), 0.2);
    transform: translateZ(0) translateY(-2px); /* For better performance and raised look */
    border-radius: var(--radius-md);
  }

  .resume-button i {
    margin-right: var(--space-sm);
    color: var(--color-primary);
    transition: all var(--transition-medium);
    width: 20px;
    height: 20px;
    filter: drop-shadow(0 0 3px rgba(var(--color-primary-rgb), 0.5));
  }

  .resume-button::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, var(--color-primary), var(--color-secondary));
    z-index: -2;
    opacity: 0.3;
    transition: opacity var(--transition-medium), filter var(--transition-medium);
    border-radius: var(--radius-md);
    filter: blur(2px);
  }

  .resume-button::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #0F172A;
    z-index: -1;
    border-radius: calc(var(--radius-md) - 2px);
  }

  .resume-button:hover {
    color: white;
    transform: translateY(-5px) scale(1.03);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25), 0 0 15px rgba(var(--color-primary-rgb), 0.5);
  }

  .resume-button:hover i {
    transform: translateY(-2px) scale(1.1);
    color: var(--color-secondary);
    filter: drop-shadow(0 0 5px rgba(var(--color-secondary-rgb), 0.8));
  }

  .resume-button:hover::before {
    opacity: 0.8;
    animation: pulse 1.5s infinite;
    filter: blur(3px);
  }

  @keyframes pulse {
    0% { opacity: 0.6; }
    50% { opacity: 1; }
    100% { opacity: 0.6; }
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background-color: #0b5ed7;
  }

  .skills-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-lg);
  }

  .skill-category {
    background-color: var(--color-card-bg);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all var(--transition-medium);
  }

  .skill-category:hover {
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15), 0 0 10px rgba(var(--color-primary-rgb), 0.05);
    transform: translateY(-3px);
  }

  .skill-category h3 {
    margin-bottom: var(--space-md);
    color: var(--color-primary);
    font-size: calc(var(--fs-h3) * 0.85);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-xs);
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: center;
    justify-content: flex-start;
  }

  /* Using the unified tag styles from global.css */

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  /* Project card styles are handled by ProjectCard.astro component */

  .contact-section {
    margin-bottom: 4rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-lg);
    transition: all var(--transition-medium);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(170deg, rgba(0, 191, 255, 0.35) 0%, rgba(0, 191, 255, 0.06) 50%, rgba(255,255,255,0.04) 100%) border-box;
    border: 1px solid transparent;
    font-size: var(--fs-body);
  }

  .contact-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18), 0 0 12px rgba(var(--color-primary-rgb), 0.1);
    color: var(--color-primary);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(170deg, rgba(0, 191, 255, 0.6) 0%, rgba(0, 191, 255, 0.12) 50%, rgba(255,255,255,0.06) 100%) border-box;
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(var(--color-primary-rgb), 0.08);
    box-sizing: border-box;
    flex-shrink: 0;
    transition: all var(--transition-medium);
  }

  .contact-icon i {
    width: 18px;
    height: 18px;
    color: var(--color-primary);
    stroke: var(--color-primary);
    stroke-width: 1.5;
    transition: all var(--transition-medium);
  }

  .contact-link:hover .contact-icon {
    background-color: rgba(var(--color-primary-rgb), 0.15);
  }

  .education-section {
    margin-bottom: 2.5rem;
  }

  .education-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .education-timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 24px;
    width: 3px;
    background: linear-gradient(to bottom, 
      var(--color-primary), 
      var(--color-secondary));
    opacity: 0.6;
    border-radius: var(--radius-full);
    filter: blur(1px);
    box-shadow: 0 0 8px rgba(var(--color-primary-rgb), 0.3);
  }

  .education-item {
    display: flex;
    gap: var(--space-md);
    position: relative;
    z-index: 1;
    margin-bottom: var(--space-md);
  }

  .education-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-card-bg);
    border: 2px solid var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(var(--color-primary-rgb), 0.3);
    position: relative;
    z-index: 2;
    flex-direction: column;
  }

  .education-icon i {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
    stroke: var(--color-primary);
    stroke-width: 1.5;
  }

  .education-year {
    position: absolute;
    top: -25px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    background-color: rgba(var(--color-primary-rgb), 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(var(--color-primary-rgb), 0.2);
  }

  .education-content {
    flex: 1;
    padding: var(--space-md);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);
  }

  .education-content:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .education-title {
    font-family: var(--font-alt);
    font-size: var(--fs-h3);
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .education-major {
    font-family: var(--font-alt);
    font-size: var(--fs-body);
    color: var(--color-secondary);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .education-description {
    font-family: var(--font-alt);
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Laptop screen adjustments */
  @media (min-width: 1024px) {
    .values-timeline {
      gap: calc(var(--space-lg) * 0.8);
    }

    .education-timeline {
      gap: calc(var(--space-lg) * 0.8);
    }

    .value-item {
      margin-bottom: calc(var(--space-md) * 0.8);
    }

    .education-item {
      margin-bottom: calc(var(--space-md) * 0.8);
    }
  }

  @media (max-width: 768px) {
    .about-content {
      flex-direction: column;
    }

    .values-timeline::before {
      left: 30px;
    }

    .value-item {
      padding-left: var(--space-xs);
    }

    .value-icon {
      width: 40px;
      height: 40px;
    }

    .value-icon i {
      width: 20px;
      height: 20px;
    }

    .value-content {
      padding: var(--space-sm);
    }

    .contact-links {
      flex-direction: column;
    }

    .education-timeline::before {
      left: 30px;
    }

    .education-item {
      padding-left: var(--space-xs);
    }

    .education-icon {
      width: 40px;
      height: 40px;
      font-size: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .values-timeline::before {
      left: 25px;
    }

    .value-icon {
      width: 36px;
